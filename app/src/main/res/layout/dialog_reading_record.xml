<?xml version="1.0" encoding="utf-8"?>
<!-- 阅读记录编辑弹窗（v5.7） -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_xl"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm">

        <TextView
            style="@style/DialogSectionTitle"
            android:layout_marginBottom="6dp"
            android:text="阅读状态" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_rec_status"
            style="@style/Widget.Bookshelf.ChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_rec_none"
                style="@style/Widget.Bookshelf.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="未读" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_rec_reading"
                style="@style/Widget.Bookshelf.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="在读" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_rec_done"
                style="@style/Widget.Bookshelf.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="已读" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_rec_dropped"
                style="@style/Widget.Bookshelf.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="弃读" />
        </com.google.android.material.chip.ChipGroup>

        <!-- 记录口径（v5.9.1）：模糊 = 只记起止；精确 = 哪几天读过由打卡表说了算。
             老记录默认模糊，切到精确不会改写任何历史字段。 -->
        <TextView
            style="@style/DialogSectionTitle"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginBottom="6dp"
            android:text="记录口径" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_rec_mode"
            style="@style/Widget.Bookshelf.ChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_rec_fuzzy"
                style="@style/Widget.Bookshelf.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="模糊（记起止）" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_rec_precise"
                style="@style/Widget.Bookshelf.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="精确（记日子）" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Bookshelf.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:hint="开始阅读（点选日期）">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_rec_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Bookshelf.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:hint="结束阅读（点选日期）">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_rec_end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tv_rec_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="阅读天数：—"
            android:textColor="?attr/on_surface_variant"
            android:textSize="@dimen/text_body_small" />

        <!-- 精确模式才出现：复用打卡页的月历做选择器，不引第三方日历库。
             起止两个输入框在这一档变成派生值的只读展示，点不动。 -->
        <LinearLayout
            android:id="@+id/ll_rec_precise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_rec_picked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="已选 0 天"
                android:textColor="?attr/on_surface_variant"
                android:textSize="@dimen/text_body_small" />

            <com.bai.bookshelf.ui.checkin.MonthGridView
                android:id="@+id/mg_rec_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm" />

            <TextView
                android:id="@+id/tv_rec_pick_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="点一天勾上，长按一天再点另一天框住整段"
                android:textColor="?attr/on_surface_variant"
                android:textSize="@dimen/text_caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_rec_span"
                    style="@style/Widget.Bookshelf.Button.Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="整段沿用" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_rec_clear"
                    style="@style/Widget.Bookshelf.Button.Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="清空" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_rec_move"
                    style="@style/Widget.Bookshelf.Button.Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="移到别轮" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我的评分" />

            <SeekBar
                android:id="@+id/seek_rec_rating"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:max="10" />

            <TextView
                android:id="@+id/tv_rec_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 分"
                android:textColor="?attr/accent_text" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
