<?xml version="1.0" encoding="utf-8"?>
<!-- 想读清单条目（v5.7：支持多选与手动拖动） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cb_wish_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_wish_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/on_surface"
            android:textSize="@dimen/text_body_large" />

        <TextView
            android:id="@+id/tv_wish_priority"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_filter_pill"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="?attr/on_surface_variant"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:id="@+id/tv_wish_in_shelf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_filter_pill_selected"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:text="已在书架"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_wish_drag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="拖动排序"
            android:padding="8dp"
            android:text="≡"
            android:textColor="?attr/on_surface_variant"
            android:textSize="@dimen/text_headline"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_wish_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/on_surface_variant"
        android:textSize="@dimen/text_body_small"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_wish_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="?attr/on_surface_variant"
        android:textSize="@dimen/text_body_small"
        android:visibility="gone" />
</LinearLayout>
