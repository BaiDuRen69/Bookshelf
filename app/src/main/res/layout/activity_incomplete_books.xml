<?xml version="1.0" encoding="utf-8"?>
<!-- 书籍信息补全（v5.7）：列出缺少封面/分类/地点的书 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Bookshelf.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_h"
        app:navigationIcon="@drawable/ic_back"
        app:title="书籍信息补全" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/page_padding"
        android:paddingVertical="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="缺少项"
            android:textColor="?attr/on_surface_variant"
            android:textSize="@dimen/text_body_small" />

        <Spinner
            android:id="@+id/sp_incomplete_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:minHeight="40dp" />

        <TextView
            android:id="@+id/tv_incomplete_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/on_surface_variant"
            android:textSize="@dimen/text_body_small" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_incomplete"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/page_padding"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tv_incomplete_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="所有书籍信息都补全了"
            android:textColor="?attr/on_surface_variant"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
