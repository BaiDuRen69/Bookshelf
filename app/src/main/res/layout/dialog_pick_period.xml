<?xml version="1.0" encoding="utf-8"?>
<!-- 年/月快速选择器（v4.20）：点击「我的阅读」页的年/月标题弹出。
     月模式：上方年份快捷条（横滑）+ 下方 12 个月格子；
     年模式：仅年份格子。点年份即跳转，点月份即跳到该年该月。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <!-- 年份快捷条（仅月模式可见） -->
    <HorizontalScrollView
        android:id="@+id/hs_year_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_year_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <!-- 年份格子（仅年模式可见）：代码按 4 列一行填充 -->
    <LinearLayout
        android:id="@+id/ll_year_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- 月份格子（仅月模式可见）：4 行 × 3 列 -->
    <LinearLayout
        android:id="@+id/grid_months"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/m1"
                style="@style/Widget.Bookshelf.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="1月" />

            <TextView
                android:id="@+id/m2"
                style="@style/Widget.Bookshelf.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="2月" />

            <TextView
                android:id="@+id/m3"
                style="@style/Widget.Bookshelf.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="3月" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/m4"
                style="@style/Widget.Bookshelf.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="4月" />

            <TextView
                android:id="@+id/m5"
                style="@style/Widget.Bookshelf.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="5月" />

            <TextView
                android:id="@+id/m6"
                style="@style/Widget.Bookshelf.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="6月" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/m7"
                style="@style/Widget.Bookshelf.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="7月" />

            <TextView
                android:id="@+id/m8"
                style="@style/Widget.Bookshelf.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="8月" />

            <TextView
                android:id="@+id/m9"
                style="@style/Widget.Bookshelf.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="9月" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/m10"
                style="@style/Widget.Bookshelf.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="10月" />

            <TextView
                android:id="@+id/m11"
                style="@style/Widget.Bookshelf.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="11月" />

            <TextView
                android:id="@+id/m12"
                style="@style/Widget.Bookshelf.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="12月" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
