<?xml version="1.0" encoding="utf-8"?>
<!-- 发现新版本弹窗（v4.7 首版；v4.17 重构：说明区可滚动 + 按钮紧凑化；
     v4.18：统一弹窗视觉，标题/说明配色走语义色） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/DialogContent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_new_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/on_surface"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

    <!-- v4.17：maxHeight 对 ScrollView 无效（只对 TextView/ImageView 生效），
         改为在代码中按屏幕高度限制本容器高度，超长内容内部滚动，保证下方按钮始终可见 -->
    <ScrollView
        android:id="@+id/scroll_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tv_update_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.4"
            android:textColor="?attr/on_surface_variant"
            android:textSize="@dimen/text_body_small" />
    </ScrollView>

    <!-- 主操作：立即更新（整行强调） -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_update_now"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:text="立即更新" />

    <!-- v4.17：三个次要选项改为横排，弹窗整体高度减少约 100dp，
         说明区再长也不会把按钮顶出屏幕 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_next_time"
            style="@style/Widget.Bookshelf.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="8dp"
            android:text="下次再说"
            android:textSize="@dimen/text_caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ignore_version"
            style="@style/Widget.Bookshelf.Button.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="8dp"
            android:text="忽略此版本"
            android:textSize="@dimen/text_caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_never"
            style="@style/Widget.Bookshelf.Button.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="8dp"
            android:text="永不提示"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>
</LinearLayout>
