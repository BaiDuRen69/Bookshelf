<?xml version="1.0" encoding="utf-8"?>
<!-- 录入方式半屏面板（v4.28）：一张卡 + 内缩分割线的三行入口；
     外层 ScrollView 让大字号/小屏时内容可滚动，不再被窗口底部裁切 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sheet_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/sheet_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xl"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/space_xl"
        android:paddingBottom="@dimen/space_xl">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_handle" />

        <TextView
            style="@style/Text.Bookshelf.SerifHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="录入方式"
            android:textColor="?attr/on_surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="选择一种方式，把这本书记进书房"
            android:textColor="?attr/on_surface_variant"
            android:textSize="@dimen/text_body_small" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/row_scan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="@dimen/space_md">

                <ImageView
                    android:layout_width="@dimen/mine_icon_box"
                    android:layout_height="@dimen/mine_icon_box"
                    android:background="@drawable/bg_icon_container"
                    android:contentDescription="扫码录入"
                    android:padding="8dp"
                    android:src="@drawable/ic_scan_line"
                    app:tint="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MineRowTitle"
                        android:text="扫码录入" />

                    <TextView
                        style="@style/MineRowSubtitle"
                        android:text="扫 ISBN 条形码，最快" />
                </LinearLayout>

                <ImageView style="@style/MineRowChevron" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="60dp"
                android:background="?attr/outline" />

            <LinearLayout
                android:id="@+id/row_isbn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="@dimen/space_md">

                <ImageView
                    android:layout_width="@dimen/mine_icon_box"
                    android:layout_height="@dimen/mine_icon_box"
                    android:background="@drawable/bg_icon_container"
                    android:contentDescription="手动输入 ISBN"
                    android:padding="8dp"
                    android:src="@drawable/ic_search"
                    app:tint="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MineRowTitle"
                        android:text="手动输入 ISBN" />

                    <TextView
                        style="@style/MineRowSubtitle"
                        android:text="知道 ISBN 时直接查询" />
                </LinearLayout>

                <ImageView style="@style/MineRowChevron" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="60dp"
                android:background="?attr/outline" />

            <LinearLayout
                android:id="@+id/row_manual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="@dimen/space_md">

                <ImageView
                    android:layout_width="@dimen/mine_icon_box"
                    android:layout_height="@dimen/mine_icon_box"
                    android:background="@drawable/bg_icon_container"
                    android:contentDescription="完全手动录入"
                    android:padding="8dp"
                    android:src="@drawable/ic_edit"
                    app:tint="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MineRowTitle"
                        android:text="完全手动录入" />

                    <TextView
                        style="@style/MineRowSubtitle"
                        android:text="没有条码也能逐项填写" />
                </LinearLayout>

                <ImageView style="@style/MineRowChevron" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
