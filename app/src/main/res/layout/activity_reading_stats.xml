<?xml version="1.0" encoding="utf-8"?>
<!-- 购书统计（v2.8，v4.41 更名）：月/年/总 三个 Tab 的购入/录入/花费统计 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Bookshelf.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_h"
        app:navigationIcon="@drawable/ic_back"
        app:title="购书统计" />

    <!-- 顶部 Tab：月 / 年 / 总（v4.25 统一为 v4.22 分段控件） -->
    <LinearLayout
        android:id="@+id/ll_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/page_padding"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_seg_track"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/tab_month"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="月"
            android:textColor="?attr/on_surface"
            android:textSize="@dimen/text_body_small" />

        <TextView
            android:id="@+id/tab_year"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="年"
            android:textColor="?attr/on_surface"
            android:textSize="@dimen/text_body_small" />

        <TextView
            android:id="@+id/tab_total"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="总"
            android:textColor="?attr/on_surface"
            android:textSize="@dimen/text_body_small" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/page_padding"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_xl">

            <!-- ==================== 月视图 ==================== -->
            <LinearLayout
                android:id="@+id/ll_month"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 与右侧 32dp 选择按钮对称，让标题真正居中 -->
                    <View
                        android:layout_width="34dp"
                        android:layout_height="1dp" />

                    <ImageButton
                        android:id="@+id/btn_month_prev"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="上个月"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_chevron_left_line"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/tv_month_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="2026年10月"
                        android:textColor="?attr/on_surface"
                        android:textSize="17sp"
                        android:fontFamily="serif"
                        android:includeFontPadding="false" />

                    <ImageButton
                        android:id="@+id/btn_month_next"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="下个月"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_chevron_right_line"
                        app:tint="?attr/colorPrimary" />

                    <!-- v4.20：点击标题直接弹出年/月选择器（原先只能靠 ‹ › 一格格翻） -->
                    <ImageView
                        android:id="@+id/btn_month_pick"
                        android:layout_width="32dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="2dp"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="选择月份"
                        android:padding="6dp"
                        android:src="@drawable/ic_chevron_down_line"
                        app:tint="?attr/colorPrimary" />
                </LinearLayout>

                <!-- v4.25：tinted 摘要卡，突出购买 / 录入 / 花费三个数字 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_summary_card"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_month_bought"
                            style="@style/Text.Bookshelf.SerifNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="本月购买"
                            android:textColor="?attr/on_primary_container"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_month_entered"
                            style="@style/Text.Bookshelf.SerifNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="本月录入"
                            android:textColor="?attr/on_primary_container"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_month_cost_value"
                            style="@style/Text.Bookshelf.SerifNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="¥0"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="本月花费"
                            android:textColor="?attr/on_primary_container"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 每日购买柱状图卡 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="每日购买本数"
                        android:textColor="?attr/on_surface_variant"
                        android:textSize="@dimen/text_body_small" />

                    <TextView
                        android:id="@+id/btn_month_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:drawableEnd="@drawable/ic_arrow_small"
                        android:drawablePadding="2dp"
                        android:drawableTint="?attr/colorPrimary"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="4dp"
                        android:text="@string/stats_all_records"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/text_body_small" />
                </LinearLayout>

                <com.bai.bookshelf.ui.stats.MiniBarChartView
                    android:id="@+id/chart_month"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="4dp" />

                <!-- v2.9：每日图表拆两行展示，避免 31 根柱挤在一行 -->
                <com.bai.bookshelf.ui.stats.MiniBarChartView
                    android:id="@+id/chart_month2"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
                </LinearLayout>

                <!-- 购买日历热力图卡 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="购买日历"
                        android:textColor="?attr/on_surface_variant"
                        android:textSize="@dimen/text_body_small" />

                    <com.bai.bookshelf.ui.stats.PurchaseHeatmapView
                        android:id="@+id/heatmap_month"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tv_month_day_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/stats_click_day_hint"
                        android:textColor="?attr/on_surface_variant"
                        android:textSize="@dimen/text_body_small" />

                    <LinearLayout
                        android:id="@+id/ll_month_legend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </LinearLayout>

                <!-- 本月购买排行卡 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        android:id="@+id/tv_month_rank_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本月购买排行"
                        android:textColor="?attr/on_surface_variant"
                        android:textSize="@dimen/text_body_small" />

                    <LinearLayout
                        android:id="@+id/ll_month_rank"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

            <!-- ==================== 年视图 ==================== -->
            <LinearLayout
                android:id="@+id/ll_year"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 与右侧 32dp 选择按钮对称，让标题真正居中 -->
                    <View
                        android:layout_width="34dp"
                        android:layout_height="1dp" />

                    <ImageButton
                        android:id="@+id/btn_year_prev"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="上一年"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_chevron_left_line"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/tv_year_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="2026年"
                        android:textColor="?attr/on_surface"
                        android:textSize="17sp"
                        android:fontFamily="serif"
                        android:includeFontPadding="false" />

                    <ImageButton
                        android:id="@+id/btn_year_next"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="下一年"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_chevron_right_line"
                        app:tint="?attr/colorPrimary" />

                    <!-- v4.20：点击标题直接弹出年份选择器 -->
                    <ImageView
                        android:id="@+id/btn_year_pick"
                        android:layout_width="32dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="2dp"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="选择年份"
                        android:padding="6dp"
                        android:src="@drawable/ic_chevron_down_line"
                        app:tint="?attr/colorPrimary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_summary_card"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_year_bought"
                            style="@style/Text.Bookshelf.SerifNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="本年购买"
                            android:textColor="?attr/on_primary_container"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_year_entered"
                            style="@style/Text.Bookshelf.SerifNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="本年录入"
                            android:textColor="?attr/on_primary_container"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_year_cost_value"
                            style="@style/Text.Bookshelf.SerifNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="¥0"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="本年花费"
                            android:textColor="?attr/on_primary_container"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 每月购买柱状图卡 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="每月购买本数"
                        android:textColor="?attr/on_surface_variant"
                        android:textSize="@dimen/text_body_small" />

                    <TextView
                        android:id="@+id/btn_year_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:drawableEnd="@drawable/ic_arrow_small"
                        android:drawablePadding="2dp"
                        android:drawableTint="?attr/colorPrimary"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="4dp"
                        android:text="@string/stats_all_records"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/text_body_small" />
                </LinearLayout>

                <com.bai.bookshelf.ui.stats.MiniBarChartView
                    android:id="@+id/chart_year"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- 购买日历热力图卡 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="购买日历"
                        android:textColor="?attr/on_surface_variant"
                        android:textSize="@dimen/text_body_small" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:scrollbars="none">

                        <com.bai.bookshelf.ui.stats.PurchaseHeatmapView
                            android:id="@+id/heatmap_year"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/tv_year_day_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/stats_click_day_hint"
                        android:textColor="?attr/on_surface_variant"
                        android:textSize="@dimen/text_body_small" />

                    <LinearLayout
                        android:id="@+id/ll_year_legend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </LinearLayout>

                <!-- 本年购买排行卡 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        android:id="@+id/tv_year_rank_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本年购买排行"
                        android:textColor="?attr/on_surface_variant"
                        android:textSize="@dimen/text_body_small" />

                    <LinearLayout
                        android:id="@+id/ll_year_rank"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

            <!-- ==================== 总视图 ==================== -->
            <LinearLayout
                android:id="@+id/ll_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 阅读时长 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Bookshelf.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tv_total_duration"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="--"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_total_range"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="从购买第一本书起计算"
                            android:textColor="?attr/on_surface_variant"
                            android:textSize="@dimen/text_body_small" />

                        <TextView
                            android:id="@+id/tv_total_companion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:textColor="?attr/on_surface_variant"
                            android:textSize="@dimen/text_body_small" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 总量统计（v2.9）：左列阅读状态，右列来源；数字加大突出 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    style="@style/Widget.Bookshelf.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_lg">

                        <!-- 左列：未读 / 在读 / 已读 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginTop="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="未读"
                                    android:textColor="?attr/on_surface_variant"
                                    android:textSize="@dimen/text_body_small" />

                                <TextView
                                    android:id="@+id/tv_total_none"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="0"
                                    android:textColor="?attr/colorPrimary"
                                    android:textSize="@dimen/text_display"
                                    android:fontFamily="serif"
                                    android:fontFeatureSettings="tnum"
                                    android:includeFontPadding="false" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginTop="14dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="在读"
                                    android:textColor="?attr/on_surface_variant"
                                    android:textSize="@dimen/text_body_small" />

                                <TextView
                                    android:id="@+id/tv_total_reading"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="0"
                                    android:textColor="?attr/colorPrimary"
                                    android:textSize="@dimen/text_display"
                                    android:fontFamily="serif"
                                    android:fontFeatureSettings="tnum"
                                    android:includeFontPadding="false" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginTop="14dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="已读"
                                    android:textColor="?attr/on_surface_variant"
                                    android:textSize="@dimen/text_body_small" />

                                <TextView
                                    android:id="@+id/tv_total_done"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="0"
                                    android:textColor="?attr/colorPrimary"
                                    android:textSize="@dimen/text_display"
                                    android:fontFamily="serif"
                                    android:fontFeatureSettings="tnum"
                                    android:includeFontPadding="false" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- 右列：买了 / 录入 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginTop="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="买了"
                                    android:textColor="?attr/on_surface_variant"
                                    android:textSize="@dimen/text_body_small" />

                                <TextView
                                    android:id="@+id/tv_total_bought"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="0"
                                    android:textColor="?attr/colorPrimary"
                                    android:textSize="@dimen/text_display"
                                    android:fontFamily="serif"
                                    android:fontFeatureSettings="tnum"
                                    android:includeFontPadding="false" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginTop="14dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="录入"
                                    android:textColor="?attr/on_surface_variant"
                                    android:textSize="@dimen/text_body_small" />

                                <TextView
                                    android:id="@+id/tv_total_entered"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="0"
                                    android:textColor="?attr/colorPrimary"
                                    android:textSize="@dimen/text_display"
                                    android:fontFamily="serif"
                                    android:fontFeatureSettings="tnum"
                                    android:includeFontPadding="false" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 每年购买柱状图卡 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="每年购买本数"
                            android:textColor="?attr/on_surface_variant"
                            android:textSize="@dimen/text_body_small" />

                        <TextView
                            android:id="@+id/btn_total_detail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:drawableEnd="@drawable/ic_arrow_small"
                            android:drawablePadding="2dp"
                            android:drawableTint="?attr/colorPrimary"
                            android:gravity="center_vertical"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="4dp"
                            android:paddingBottom="4dp"
                            android:text="@string/stats_all_records"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_body_small" />
                    </LinearLayout>

                    <com.bai.bookshelf.ui.stats.MiniBarChartView
                        android:id="@+id/chart_total"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 空态（v4.29）：与书架一致，垂直居中 -->
            <FrameLayout
                android:id="@+id/empty_state_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone">

                <include
                    android:id="@+id/empty_state"
                    layout="@layout/view_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
