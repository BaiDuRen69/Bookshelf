<?xml version="1.0" encoding="utf-8"?>
<!-- 年视图（一期第 ② 步骨架，第 ④ 步填 12 月缩略网格与左右滑切年份）。
     先提供一个可进入、可返回、带年份的真实页面，让「点月份标题 → 年视图」在本步即可验证。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Bookshelf.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_h"
        app:navigationIcon="@drawable/ic_back"
        app:title="选择月份" />

    <TextView
        android:id="@+id/tv_year"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/space_lg"
        android:textColor="?attr/on_surface"
        android:textSize="@dimen/text_title"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/year_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_padding"
        android:paddingBottom="@dimen/dock_reserve" />
</LinearLayout>
