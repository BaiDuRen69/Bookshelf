<?xml version="1.0" encoding="utf-8"?>
<!-- 年视图（第 ④ 步）：居中年份 + 今年小结 + 12 个月网格 + 悬浮「今」。
     底部避让沿用 @dimen/dock_reserve，颜色全部取 ?attr 语义色。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.Bookshelf.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_h"
            app:navigationIcon="@drawable/ic_back"
            app:title="选择月份" />

        <TextView
            android:id="@+id/tv_year"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:textColor="?attr/on_surface"
            android:textSize="@dimen/text_title" />

        <TextView
            android:id="@+id/tv_year_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:gravity="center"
            android:textColor="?attr/on_surface_variant"
            android:textSize="@dimen/text_body_small" />

        <com.bai.bookshelf.ui.checkin.CheckInYearView
            android:id="@+id/year_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/page_padding"
            android:paddingBottom="@dimen/dock_reserve" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/fab_today"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="@dimen/dock_reserve"
        android:contentDescription="回到今天"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:insetTop="0dp"
        android:padding="0dp"
        android:text="今"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="@dimen/text_body_large"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="28dp"
        app:elevation="4dp" />
</FrameLayout>
