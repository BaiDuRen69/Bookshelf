<?xml version="1.0" encoding="utf-8"?>
<!-- 书架封面视图项（v4.30 重写，v5.8.14 书脊厚度 + 底部进度线）：
     封面 3:4，左侧书脊宽度按册数（6/8/10dp），底部 2dp 阅读进度线 + 右下角百分比。 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:stateListAnimator="@animator/press_scale">

    <FrameLayout
        android:id="@+id/cover_frame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_cover"
        android:clipToOutline="true"
        android:foreground="@drawable/bg_cover_stroke"
        app:layout_constraintDimensionRatio="H,3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.bai.bookshelf.ui.widget.RatioImageView
            android:id="@+id/iv_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <!-- 书脊：宽度由 BookSpine 按册数 / 套装设定，生成封面不透明、真实封面半透明 -->
        <View
            android:id="@+id/v_spine"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@drawable/bg_book_spine" />

        <!-- 状态：书脊底部的 3dp 色条（像书签尾），颜色由 ShelfAccent 按状态着色 -->
        <View
            android:id="@+id/v_status_accent"
            android:layout_width="3dp"
            android:layout_height="26dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_status_accent"
            android:visibility="gone" />

        <!-- v5.8.14：底部 2dp 阅读进度线 -->
        <ProgressBar
            android:id="@+id/pb_cover_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progressBackgroundTint="@android:color/transparent"
            android:progressDrawable="@drawable/progress_cover"
            android:progressTint="?attr/colorPrimary"
            android:visibility="gone" />

        <!-- v5.8.14：右下角百分比 -->
        <TextView
            android:id="@+id/tv_progress_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_progress_badge"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:visibility="gone" />
        <!-- v5.8.15：多选态——12% 主色蒙层 + 右上勾选圈 -->
        <View
            android:id="@+id/v_select_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.12"
            android:background="?attr/colorPrimary"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_select_check"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_check_circle"
            android:importantForAccessibility="no"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_check_line"
            app:tint="?attr/colorOnPrimary"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 书名：两行居中，行距收紧 -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.15"
        android:maxLines="2"
        android:minLines="2"
        android:textColor="?attr/on_surface"
        android:textSize="@dimen/text_body_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cover_frame" />
</androidx.constraintlayout.widget.ConstraintLayout>
