<?xml version="1.0" encoding="utf-8"?>
<!-- 书架封面视图项：封面大图 + 左上角标 + 下方书名
     v4.18：去掉外层卡片，改为「封面描边 + 紧凑书名」，缩小书籍间距，
     并用 1dp 描边（bg_cover_stroke）勾出每本书的边界 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/iv_cover"
            android:contentDescription="书籍封面"
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:background="@drawable/bg_cover"
            android:clipToOutline="true"
            android:foreground="@drawable/bg_cover_stroke"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_cover_placeholder" />

        <!-- 左上角标：阅读状态 -->
        <TextView
            android:id="@+id/tv_read"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="5dp"
            android:background="@drawable/bg_badge"
            android:backgroundTint="?attr/colorPrimary"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="未读"
            android:textColor="@color/white"
            android:textSize="@dimen/text_caption" />
    </FrameLayout>

    <!-- 书名：两行居中，行距收紧 -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15"
        android:maxLines="2"
        android:minLines="2"
        android:textSize="@dimen/text_body_small"
        android:textColor="?attr/on_surface" />
</LinearLayout>
