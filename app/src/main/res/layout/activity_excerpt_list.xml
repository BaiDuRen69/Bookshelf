<?xml version="1.0" encoding="utf-8"?>
<!-- 摘抄与书评（v4.50）：短评置顶 + 摘抄时间线 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Bookshelf.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_h"
        app:navigationIcon="@drawable/ic_back"
        app:title="摘抄与书评" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/page_padding">

                <TextView
                    android:id="@+id/tv_excerpt_book"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_md"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:maxLines="2"
                    android:textColor="?attr/on_surface"
                    android:textSize="20sp" />

                <!-- 我的短评 -->
                <LinearLayout
                    android:id="@+id/card_review"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:letterSpacing="0.06"
                            android:text="我的短评"
                            android:textColor="?attr/on_surface_variant"
                            android:textSize="@dimen/text_caption" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="编辑短评"
                            android:src="@drawable/ic_edit"
                            app:tint="?attr/on_surface_variant" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_review"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingMultiplier="1.5"
                        android:textColor="?attr/on_surface"
                        android:textSize="@dimen/text_body"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_review_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="写一句读完的感受…"
                        android:textColor="?attr/on_surface_variant"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>

                <!-- 摘抄标题行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:layout_marginBottom="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_excerpt_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="摘抄 · 0 条"
                        android:textColor="?attr/on_surface"
                        android:textSize="@dimen/text_headline" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="按时间倒序"
                        android:textColor="?attr/on_surface_variant"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_excerpts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/ll_excerpt_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="56dp"
                    android:paddingBottom="40dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="还没有摘抄"
                        android:textColor="?attr/on_surface"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.4"
                        android:text="读到喜欢的句子，点下方按钮记下来；\n以后按时间回看，像一条读书时间线。"
                        android:textColor="?attr/on_surface_variant"
                        android:textSize="@dimen/text_body_small" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/surface"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_padding"
        android:paddingVertical="@dimen/space_sm">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_excerpt"
            style="@style/Widget.Bookshelf.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="＋ 添加摘抄" />
    </LinearLayout>
</LinearLayout>
