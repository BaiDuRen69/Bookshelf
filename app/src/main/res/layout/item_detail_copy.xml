<?xml version="1.0" encoding="utf-8"?>
<!-- 详情页逐本信息的单行：本册摘要 + 借出/归还按钮 + 备注（最多 3 行，点击展开） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_copy_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingMultiplier="1.4"
            android:textColor="?attr/on_surface"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_copy_lend"
            style="@style/Widget.Bookshelf.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="借出"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 借出备注（前 20 字，点击看完整） -->
    <TextView
        android:id="@+id/tv_lend_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/on_surface_variant"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.3"
        android:visibility="gone" />

    <!-- 借出备注图片入口：不直接展示，点击后展开 -->
    <TextView
        android:id="@+id/tv_lend_note_images"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/colorPrimary"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/container_lend_note_images"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_copy_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/on_surface_variant"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.3"
        android:maxLines="3"
        android:ellipsize="end"
        android:visibility="gone" />
</LinearLayout>
