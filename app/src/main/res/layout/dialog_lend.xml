<?xml version="1.0" encoding="utf-8"?>
<!-- 借出登记对话框：借阅人选择（可管理） + 借出备注
     v4.18：输入框改用描边式（Widget.Bookshelf.TextField），Chip 统一全局样式。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm">

        <TextView
            style="@style/DialogSectionTitle"
            android:text="借给谁（长按可重命名/删除）" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group"
            style="@style/Widget.Bookshelf.ChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tv_borrower_contact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/on_surface_variant"
            android:textSize="@dimen/text_body_small" />

        <!-- v4.42：应还日期（默认借出后 30 天，可清空） -->
        <TextView
            android:id="@+id/tv_due_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_dialog_row"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_chevron_right_line"
            android:drawablePadding="@dimen/space_sm"
            android:drawableTint="?attr/colorPrimary"
            android:focusable="true"
            android:padding="@dimen/space_md"
            android:text="应还日期"
            android:textColor="?attr/on_surface"
            android:textSize="@dimen/text_body" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Bookshelf.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:hint="借出备注（原因、联系方式等，可空）">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="1"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 借出备注图片附件 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_note_image"
            style="@style/Widget.Bookshelf.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="＋ 添加备注图片"
            android:textSize="@dimen/text_body_small" />

        <HorizontalScrollView
            android:id="@+id/scroll_note_thumbs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/container_note_thumbs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
</ScrollView>
