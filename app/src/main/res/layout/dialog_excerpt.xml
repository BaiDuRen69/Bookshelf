<?xml version="1.0" encoding="utf-8"?>
<!-- 摘抄编辑弹窗（v4.50） -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_xl"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Bookshelf.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="页码（可空）">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_excerpt_page"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="5"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Bookshelf.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:hint="摘抄原文 / 金句（必填）">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_excerpt_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:maxLines="6"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Bookshelf.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:hint="批注 / 感想（可空）">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_excerpt_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Bookshelf.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:hint="标签（逗号分隔，可空）">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_excerpt_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_excerpt_image"
                android:layout_width="56dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_excerpt_thumb"
                android:clipToOutline="true"
                android:contentDescription="摘抄配图"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_pick_image"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:drawableStart="@drawable/ic_image_line"
                android:drawablePadding="6dp"
                android:drawableTint="?attr/colorPrimary"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="添加图片"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/text_body_small" />

            <TextView
                android:id="@+id/btn_remove_image"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="移除"
                android:textColor="?attr/on_surface_variant"
                android:textSize="@dimen/text_body_small"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
