<?xml version="1.0" encoding="utf-8"?>
<!-- 书籍详情页（v4.25）：hero 封面 + 两列信息 + 备注引用块 + 固定底栏 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Bookshelf.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_h"
        app:navigationIcon="@drawable/ic_back"
        app:title="书籍详情" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_xl"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/content_max_width">

                <!-- ==================== Hero（v4.30：封面模糊做底，叠纸色遮罩） ==================== -->
                <FrameLayout
                    android:id="@+id/hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/primary_container">

                    <ImageView
                        android:id="@+id/iv_hero_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                    <View
                        android:id="@+id/v_hero_scrim"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_gravity="bottom"
                        android:alpha="0.5"
                        android:background="?attr/colorSecondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_lg">

                    <androidx.cardview.widget.CardView
                        android:layout_width="120dp"
                        android:layout_height="160dp"
                        android:clipToOutline="true"
                        app:cardBackgroundColor="?attr/surface"
                        app:cardCornerRadius="@dimen/radius_md"
                        app:cardElevation="3dp">

                        <ImageView
                            android:id="@+id/iv_cover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="书籍封面"
                            android:scaleType="centerCrop" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_lg"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_title"
                            style="@style/Text.Bookshelf.SerifTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="3"
                            android:textColor="?attr/on_surface" />

                        <TextView
                            android:id="@+id/tv_hero_author"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:lineSpacingMultiplier="1.3"
                            android:maxLines="2"
                            android:textColor="?attr/on_surface_variant"
                            android:textSize="@dimen/text_body_small"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_hero_stock"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_status_chip"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="@dimen/text_caption"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tv_hero_read"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_status_chip"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="@dimen/text_caption"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tv_hero_own"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_status_chip"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="@dimen/text_caption"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <!-- ==================== 系列（v4.53） ==================== -->
                <LinearLayout
                    android:id="@+id/card_series"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_padding"
                    android:layout_marginTop="@dimen/space_lg"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_lg"
                    android:paddingVertical="@dimen/space_md"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_series_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="?attr/on_surface"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_series_link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="查看系列 ›"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- ==================== 书目信息 ==================== -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_info"
                    style="@style/Widget.Bookshelf.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_padding"
                    android:layout_marginTop="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_lg">

                        <TextView
                            style="@style/DetailSectionTitle"
                            android:text="书目信息" />

                        <LinearLayout
                            android:id="@+id/ll_info_grid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:orientation="vertical" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ==================== 藏书信息 ==================== -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_core"
                    style="@style/Widget.Bookshelf.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_padding"
                    android:layout_marginTop="@dimen/space_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_lg">

                        <TextView
                            style="@style/DetailSectionTitle"
                            android:text="藏书信息" />

                        <LinearLayout
                            android:id="@+id/ll_core_grid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:orientation="vertical" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- v4.42：借阅到期横幅（点按复制催还文案，长按改应还日期） -->
                <TextView
                    android:id="@+id/tv_borrow_due"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_padding"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="@dimen/space_md"
                    android:textColor="?attr/on_surface"
                    android:textSize="@dimen/text_body_small"
                    android:visibility="gone" />

                <!-- ==================== 我的书房 ==================== -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_manage"
                    style="@style/Widget.Bookshelf.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_padding"
                    android:layout_marginTop="@dimen/space_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_lg">

                        <TextView
                            style="@style/DetailSectionTitle"
                            android:text="我的书房" />

                        <LinearLayout
                            android:id="@+id/ll_manage_grid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:orientation="vertical" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ==================== 借出备注 ==================== -->
                <TextView
                    android:id="@+id/tv_manage_lend_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_padding"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@drawable/bg_quote_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:lineSpacingMultiplier="1.7"
                    android:paddingStart="28dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="@dimen/space_lg"
                    android:paddingBottom="14dp"
                    android:textColor="?attr/on_surface"
                    android:textSize="@dimen/text_body"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/row_manage_lend_note_images"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_padding"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_image_line"
                    android:drawableEnd="@drawable/ic_chevron_right_line"
                    android:drawablePadding="@dimen/space_sm"
                    android:drawableTint="?attr/colorPrimary"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:padding="@dimen/space_md"
                    android:text="借出备注图片"
                    android:textColor="?attr/on_surface"
                    android:textSize="@dimen/text_body_small"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/container_manage_lend_note_images"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_padding"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- ==================== 备注 ==================== -->
                <TextView
                    android:id="@+id/tv_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_padding"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@drawable/bg_quote_card"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:lineSpacingMultiplier="1.7"
                    android:maxLines="3"
                    android:paddingStart="28dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="@dimen/space_lg"
                    android:paddingBottom="14dp"
                    android:textColor="?attr/on_surface"
                    android:textSize="@dimen/text_body"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/row_note_images"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_padding"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_image_line"
                    android:drawableEnd="@drawable/ic_chevron_right_line"
                    android:drawablePadding="@dimen/space_sm"
                    android:drawableTint="?attr/colorPrimary"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:padding="@dimen/space_md"
                    android:text="备注图片"
                    android:textColor="?attr/on_surface"
                    android:textSize="@dimen/text_body_small"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/container_note_images"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_padding"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- ==================== 摘抄与书评（v4.50） ==================== -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_excerpts"
                    style="@style/Widget.Bookshelf.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_padding"
                    android:layout_marginTop="@dimen/space_md"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_lg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/DetailSectionTitle"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="摘抄与书评" />

                            <TextView
                                android:id="@+id/tv_excerpt_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/on_surface_variant"
                                android:textSize="@dimen/text_caption" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_detail_review"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:background="@drawable/bg_quote_card"
                            android:lineSpacingMultiplier="1.5"
                            android:maxLines="4"
                            android:ellipsize="end"
                            android:paddingStart="28dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="@dimen/space_md"
                            android:paddingBottom="12dp"
                            android:textColor="?attr/on_surface"
                            android:textSize="@dimen/text_body_small" />

                        <LinearLayout
                            android:id="@+id/ll_excerpt_preview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/row_all_excerpts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:drawableEnd="@drawable/ic_chevron_right_line"
                            android:drawablePadding="2dp"
                            android:drawableTint="?attr/colorPrimary"
                            android:gravity="center_vertical"
                            android:paddingVertical="4dp"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_body_small" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ==================== 逐本信息 ==================== -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_copies"
                    style="@style/Widget.Bookshelf.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_padding"
                    android:layout_marginTop="@dimen/space_md"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_lg">

                        <TextView
                            style="@style/DetailSectionTitle"
                            android:text="逐本信息" />

                        <LinearLayout
                            android:id="@+id/container_copies"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:orientation="vertical" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ==================== 借出记录入口 ==================== -->
                <TextView
                    android:id="@+id/row_borrow_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_padding"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_history_line"
                    android:drawableEnd="@drawable/ic_chevron_right_line"
                    android:drawablePadding="@dimen/space_sm"
                    android:drawableTint="?attr/colorPrimary"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:padding="@dimen/space_lg"
                    android:text="借出记录"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_body"
                    android:visibility="gone" />

                <!-- ==================== 标签 ==================== -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_tags"
                    style="@style/Widget.Bookshelf.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_padding"
                    android:layout_marginTop="@dimen/space_md"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_lg">

                        <TextView
                            android:id="@+id/tv_tags_label"
                            style="@style/DetailSectionTitle"
                            android:text="标签" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chip_group_tags"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            app:chipSpacingHorizontal="8dp"
                            app:singleLine="false" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ==================== 固定底栏 ==================== -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/surface"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/outline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/page_padding"
            android:paddingVertical="@dimen/space_sm">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit"
                style="@style/Widget.Bookshelf.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_edit" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_lend"
                style="@style/Widget.Bookshelf.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:text="借出" />

            <ImageButton
                android:id="@+id/btn_more"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/space_sm"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="更多操作"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_more"
                app:tint="?attr/on_surface_variant" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
