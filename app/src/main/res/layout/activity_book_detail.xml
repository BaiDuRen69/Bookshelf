<?xml version="1.0" encoding="utf-8"?>
<!-- 书籍详情页：封面 + 书目信息 + 管理信息 + 操作按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:navigationIcon="@drawable/ic_back"
        app:title="书籍详情"
        app:titleTextColor="@color/white" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="16dp">

            <ImageView
                android:id="@+id/iv_cover"
                android:layout_width="96dp"
                android:layout_height="128dp"
                android:background="#EEE"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_cover_placeholder" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:gravity="center" />

            <!-- 书目信息（代码里拼多行文本） -->
            <TextView
                android:id="@+id/tv_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_chip"
                android:padding="12dp"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.5"
                android:textColor="@color/text_main" />

            <!-- 藏书核心信息（存放地点/藏书状态/来源/录入时间，独立成块不重复展示；位于书目信息 ISBN 下方） -->
            <TextView
                android:id="@+id/tv_core"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip"
                android:padding="12dp"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.5"
                android:textColor="@color/text_main" />

            <!-- 我的管理信息（不再包含「备注」，备注单独成块） -->
            <TextView
                android:id="@+id/tv_manage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip"
                android:padding="12dp"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.5"
                android:textColor="@color/text_main" />

            <!-- 单本借出备注（最多 20 字，点击展开；多本时由逐本信息展示，这里隐藏） -->
            <TextView
                android:id="@+id/tv_manage_lend_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_chip"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.5"
                android:textColor="@color/text_main"
                android:visibility="gone" />

            <!-- 单本借出备注图片（默认折叠） -->
            <TextView
                android:id="@+id/row_manage_lend_note_images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_chip"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:text="借出备注图片"
                android:textSize="14sp"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/container_manage_lend_note_images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- 备注（最多 3 行，点击展开） -->
            <TextView
                android:id="@+id/tv_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip"
                android:padding="12dp"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.5"
                android:textColor="@color/text_main"
                android:maxLines="3"
                android:ellipsize="end"
                android:visibility="gone" />

            <!-- 备注图片（默认折叠，点击展开/收起） -->
            <TextView
                android:id="@+id/row_note_images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_chip"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:text="备注图片"
                android:textSize="14sp"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/container_note_images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- 逐本信息（拥有数量 > 1 时展示，> 3 本默认只显示前 3 本，点击展开剩余） -->
            <LinearLayout
                android:id="@+id/container_copies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_chip"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone" />

            <!-- 借出记录入口（仅借出过才显示） -->
            <TextView
                android:id="@+id/row_borrow_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:text="借出记录 ›"
                android:textSize="14sp"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone" />

            <!-- 标签独立展示区 -->
            <TextView
                android:id="@+id/tv_tags_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="标签"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="false"
                android:visibility="gone" />

            <!-- 内容简介：v3.6 起不再使用（API 不导入、编辑页无入口），永久隐藏 -->
            <TextView
                android:id="@+id/tv_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.4"
                android:textColor="@color/text_sub"
                android:visibility="gone" />

            <!-- 操作按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_edit" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_lend"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="借出"
                    style="@style/Widget.Material3.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_delete"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/action_delete"
                    style="@style/Widget.Material3.Button.OutlinedButton" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
