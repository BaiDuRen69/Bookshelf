<?xml version="1.0" encoding="utf-8"?>
<!-- 书籍详情页：封面 + 书目信息 + 管理信息 + 操作按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Bookshelf.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_h"
        app:navigationIcon="@drawable/ic_back"
        app:title="书籍详情" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

                <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

<LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="@dimen/page_padding"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/space_xl"
                    app:layout_constraintWidth_max="@dimen/content_max_width"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                >

            <ImageView
                android:id="@+id/iv_cover"
                android:layout_width="96dp"
                android:layout_height="128dp"
                android:background="@drawable/bg_cover"
                    android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_cover_placeholder" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                android:textColor="?attr/on_surface"
                android:gravity="center" />

            <!-- 书目信息（代码里拼多行文本） -->
            <TextView
                android:id="@+id/tv_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_lg"
                android:textSize="@dimen/text_body"
                android:lineSpacingMultiplier="1.6"
                android:textColor="?attr/on_surface" />

            <!-- 藏书核心信息（存放地点/藏书状态/来源/录入时间，独立成块不重复展示；位于书目信息 ISBN 下方） -->
            <TextView
                android:id="@+id/tv_core"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_lg"
                android:textSize="@dimen/text_body"
                android:lineSpacingMultiplier="1.6"
                android:textColor="?attr/on_surface" />

            <!-- 我的管理信息（不再包含「备注」，备注单独成块） -->
            <TextView
                android:id="@+id/tv_manage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_lg"
                android:textSize="@dimen/text_body"
                android:lineSpacingMultiplier="1.6"
                android:textColor="?attr/on_surface" />

            <!-- 单本借出备注（最多 20 字，点击展开；多本时由逐本信息展示，这里隐藏） -->
            <TextView
                android:id="@+id/tv_manage_lend_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:background="@drawable/bg_card"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/space_lg"
                android:textSize="@dimen/text_body"
                android:lineSpacingMultiplier="1.6"
                android:textColor="?attr/on_surface"
                android:visibility="gone" />

            <!-- 单本借出备注图片（默认折叠） -->
            <TextView
                android:id="@+id/row_manage_lend_note_images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:background="@drawable/bg_card"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/space_lg"
                android:text="借出备注图片"
                android:textSize="@dimen/text_body"
                android:textColor="?attr/on_primary_container"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/container_manage_lend_note_images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- 备注（最多 3 行，点击展开） -->
            <TextView
                android:id="@+id/tv_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_lg"
                android:textSize="@dimen/text_body"
                android:lineSpacingMultiplier="1.6"
                android:textColor="?attr/on_surface"
                android:maxLines="3"
                android:ellipsize="end"
                android:visibility="gone" />

            <!-- 备注图片（默认折叠，点击展开/收起） -->
            <TextView
                android:id="@+id/row_note_images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:background="@drawable/bg_card"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/space_lg"
                android:text="备注图片"
                android:textSize="@dimen/text_body"
                android:textColor="?attr/on_primary_container"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/container_note_images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- 逐本信息（拥有数量 > 1 时展示，> 3 本默认只显示前 3 本，点击展开剩余） -->
            <LinearLayout
                android:id="@+id/container_copies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/space_lg"
                android:visibility="gone" />

            <!-- 借出记录入口（仅借出过才显示） -->
            <TextView
                android:id="@+id/row_borrow_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_card"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/space_lg"
                android:text="借出记录 ›"
                android:textSize="@dimen/text_body"
                android:textColor="?attr/on_primary_container"
                android:visibility="gone" />

            <!-- 标签独立展示区 -->
            <TextView
                android:id="@+id/tv_tags_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="标签"
                android:textStyle="bold"
                android:textColor="?attr/on_primary_container"
                android:visibility="gone" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="false"
                android:visibility="gone" />

            <!-- 内容简介：v3.6 起不再使用（API 不导入、编辑页无入口），永久隐藏 -->
            <TextView
                android:id="@+id/tv_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:textSize="@dimen/text_body_small"
                android:lineSpacingMultiplier="1.4"
                android:textColor="?attr/on_surface_variant"
                android:visibility="gone" />

            <!-- 操作按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="@dimen/space_xl"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_edit" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_lend"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="借出"
                    style="@style/Widget.Bookshelf.Button.Outlined" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_delete"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/action_delete"
                    style="@style/Widget.Bookshelf.Button.Outlined" />
            </LinearLayout>
        </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
