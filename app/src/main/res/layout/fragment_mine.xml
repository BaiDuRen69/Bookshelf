                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/MineRowTitle"
                                    android:text="崩溃日志" />

                                <TextView
                                    android:id="@+id/tv_crash_log_state"
                                    style="@style/MineRowSubtitle"
                                    android:text="上次异常记录（点击查看并复制）" />
                            </LinearLayout>

                            <ImageView style="@style/MineRowChevron" />
                        </LinearLayout>

                        <View
                            android:id="@+id/divider_feedback"
                            style="@style/MineRowDivider" />

                        <LinearLayout
                            android:id="@+id/row_feedback_email"
                            style="@style/MineRow">

                            <ImageView
                                style="@style/MineRowIcon"
                                android:contentDescription="邮件反馈"
                                android:src="@drawable/ic_mail_line" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/MineRowTitle"
                                    android:text="邮件反馈" />

                                <TextView
                                    style="@style/MineRowSubtitle"
                                    android:text="baiduren69@outlook.com（点击直接写信）" />
                            </LinearLayout>

                            <ImageView style="@style/MineRowChevron" />
                        </LinearLayout>

                        <View style="@style/MineRowDivider" />

                        <LinearLayout
                            android:id="@+id/row_feedback_github"
                            style="@style/MineRow">

                            <ImageView
                                style="@style/MineRowIcon"
                                android:contentDescription="GitHub Issues"
                                android:src="@drawable/ic_github_line" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/MineRowTitle"
                                    android:text="GitHub Issues 反馈" />

                                <TextView
                                    style="@style/MineRowSubtitle"
                                    android:text="浏览器打开 Issue 提交页" />
                            </LinearLayout>

                            <ImageView style="@style/MineRowChevron" />
                        </LinearLayout>

                        <View style="@style/MineRowDivider" />

                        <LinearLayout
                            android:id="@+id/row_github"
                            style="@style/MineRow">

                            <ImageView
                                style="@style/MineRowIcon"
                                android:contentDescription="我的 GitHub"
                                android:src="@drawable/ic_github_line" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/MineRowTitle"
                                    android:text="我的 GitHub" />

                                <TextView
                                    style="@style/MineRowSubtitle"
                                    android:text="github.com/BaiDuRen69/Bookshelf" />
                            </LinearLayout>

                            <ImageView style="@style/MineRowChevron" />
                        </LinearLayout>

                        <View style="@style/MineRowDivider" />

                        <LinearLayout
                            android:id="@+id/row_about"
                            style="@style/MineRow">

                            <ImageView
                                style="@style/MineRowIcon"
                                android:contentDescription="关于"
                                android:src="@drawable/ic_info_line" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/MineRowTitle"
                                    android:text="关于与免责声明" />

                                <TextView
                                    android:id="@+id/tv_about_state"
                                    style="@style/MineRowSubtitle"
                                    android:text="版本与作者信息" />
                            </LinearLayout>

                            <ImageView style="@style/MineRowChevron" />
                        </LinearLayout>
