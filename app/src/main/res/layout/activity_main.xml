<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面：Fragment 容器 + 底部浮动胶囊导航（v5.8.25）。
     dock 是浮在内容上的一枚胶囊：圆形指示器画在图标下面，三个 tab 纯图标 +
     圆形水波（ripple_circle），不再用整条底栏 + 文字 + 胶囊底。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 承接系统手势条内边距（InsetsHelper 依赖这个 id）。必须填 surface：
         透明会让 windowBackground（浅色）在夜读下露成一条奶油白带。 -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/surface"
        android:orientation="horizontal"
        android:paddingVertical="0dp">

        <FrameLayout
            android:id="@+id/nav_dock"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dock_h"
            android:layout_marginHorizontal="@dimen/dock_margin_h"
            android:layout_marginBottom="@dimen/dock_margin_bottom"
            android:background="@drawable/bg_dock"
            android:elevation="@dimen/dock_elevation"
            android:outlineAmbientShadowColor="#1F3A3228"
            android:outlineSpotShadowColor="#1F3A3228">

            <!-- 指示器先添加：画在图标下面 -->
            <View
                android:id="@+id/nav_indicator"
                android:layout_width="@dimen/nav_indicator_size"
                android:layout_height="@dimen/nav_indicator_size"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_nav_indicator" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/tab_shelf"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:tooltipText="书架">

                    <FrameLayout
                        android:id="@+id/touch_shelf"
                        android:layout_width="@dimen/nav_touch_size"
                        android:layout_height="@dimen/nav_touch_size"
                        android:layout_gravity="center"
                        android:foreground="@drawable/ripple_circle">

                        <ImageView
                            android:id="@+id/iv_tab_shelf"
                            android:layout_width="@dimen/nav_icon_size"
                            android:layout_height="@dimen/nav_icon_size"
                            android:layout_gravity="center"
                            android:contentDescription="书架"
                            android:src="@drawable/ic_book_line"
                            app:tint="@color/nav_icon_tint" />

                        <TextView
                            android:id="@+id/tv_badge_shelf"
                            style="@style/BottomNavBadge"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="-2dp"
                            android:layout_marginEnd="-2dp"
                            android:visibility="gone" />
                    </FrameLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/tab_stats"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:tooltipText="统计">

                    <FrameLayout
                        android:id="@+id/touch_stats"
                        android:layout_width="@dimen/nav_touch_size"
                        android:layout_height="@dimen/nav_touch_size"
                        android:layout_gravity="center"
                        android:foreground="@drawable/ripple_circle">

                        <ImageView
                            android:id="@+id/iv_tab_stats"
                            android:layout_width="@dimen/nav_icon_size"
                            android:layout_height="@dimen/nav_icon_size"
                            android:layout_gravity="center"
                            android:contentDescription="统计"
                            android:src="@drawable/ic_chart_line"
                            app:tint="@color/nav_icon_tint" />

                        <TextView
                            android:id="@+id/tv_badge_stats"
                            style="@style/BottomNavBadge"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="-2dp"
                            android:layout_marginEnd="-2dp"
                            android:visibility="gone" />
                    </FrameLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/tab_mine"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:tooltipText="我的">

                    <FrameLayout
                        android:id="@+id/touch_mine"
                        android:layout_width="@dimen/nav_touch_size"
                        android:layout_height="@dimen/nav_touch_size"
                        android:layout_gravity="center"
                        android:foreground="@drawable/ripple_circle">

                        <ImageView
                            android:id="@+id/iv_tab_mine"
                            android:layout_width="@dimen/nav_icon_size"
                            android:layout_height="@dimen/nav_icon_size"
                            android:layout_gravity="center"
                            android:contentDescription="我的"
                            android:src="@drawable/ic_person_line"
                            app:tint="@color/nav_icon_tint" />

                        <TextView
                            android:id="@+id/tv_badge_mine"
                            style="@style/BottomNavBadge"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="-2dp"
                            android:layout_marginEnd="-2dp"
                            android:visibility="gone" />
                    </FrameLayout>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
