<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面（v5.8.26 真浮动）：内容铺满到屏幕底，dock 悬在内容之上。
     三层：container（全屏）→ nav_scrim（底部渐隐，压在内容上、dock 下）→ bottom_nav（透明、
     只承接手势条内边距）。v5.10 加第 4 个打卡 tab：dock 改 match_parent 等分 4 格，
     否则 84dp×4 + 8dp×2 = 352dp 会超出 360dp 屏的 328dp 可用宽度被裁。
     nav_indicator_size / dock_h / ripple_circle / dock_padding_h 一律沿用。
     外层一律不加 clickable，否则 dock 两侧空白处的点击会被吃掉。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 必须在 bottom_nav 之前添加：画在 dock 下面、内容上面 -->
    <View
        android:id="@+id/nav_scrim"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dock_scrim_h"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_dock_scrim" />

    <!-- 只负责承接系统手势条的内边距（InsetsHelper 依赖这个 id），本身透明 -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/transparent"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/nav_dock"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dock_h"
            android:layout_marginBottom="@dimen/dock_margin_bottom"
            android:alpha="0.95"
            android:background="@drawable/bg_dock"
            android:elevation="@dimen/dock_elevation"
            android:outlineAmbientShadowColor="#143A3228"
            android:outlineSpotShadowColor="#243A3228"
            android:paddingLeft="@dimen/dock_padding_h"
            android:paddingRight="@dimen/dock_padding_h">

            <!-- 指示器先添加：画在图标下面 -->
            <View
                android:id="@+id/nav_indicator"
                android:layout_width="@dimen/nav_indicator_size"
                android:layout_height="@dimen/nav_indicator_size"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_nav_indicator" />

            <!-- 4 格等分：子项 0dp + weight=1，父容器必须 match_parent 才生效 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/tab_shelf"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/ripple_circle"
                    android:tooltipText="书架">

                    <FrameLayout
                        android:layout_width="@dimen/nav_touch_size"
                        android:layout_height="@dimen/nav_touch_size"
                        android:layout_gravity="center">

                        <ImageView
                            android:id="@+id/iv_tab_shelf"
                            android:layout_width="@dimen/nav_icon_size"
                            android:layout_height="@dimen/nav_icon_size"
                            android:layout_gravity="center"
                            android:contentDescription="书架"
                            android:src="@drawable/ic_book_line"
                            app:tint="@color/nav_icon_tint" />
                    </FrameLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/tab_stats"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/ripple_circle"
                    android:tooltipText="统计">

                    <FrameLayout
                        android:layout_width="@dimen/nav_touch_size"
                        android:layout_height="@dimen/nav_touch_size"
                        android:layout_gravity="center">

                        <ImageView
                            android:id="@+id/iv_tab_stats"
                            android:layout_width="@dimen/nav_icon_size"
                            android:layout_height="@dimen/nav_icon_size"
                            android:layout_gravity="center"
                            android:contentDescription="统计"
                            android:src="@drawable/ic_chart_line"
                            app:tint="@color/nav_icon_tint" />

                        <TextView
                            android:id="@+id/tv_badge_stats"
                            style="@style/BottomNavBadge"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="-2dp"
                            android:layout_marginEnd="-2dp"
                            android:visibility="gone" />
                    </FrameLayout>
                </FrameLayout>

                <!-- 打卡：第 3 格，纯图标不显示文字，与其余三格一致 -->
                <FrameLayout
                    android:id="@+id/tab_checkin"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/ripple_circle"
                    android:tooltipText="打卡">

                    <FrameLayout
                        android:layout_width="@dimen/nav_touch_size"
                        android:layout_height="@dimen/nav_touch_size"
                        android:layout_gravity="center">

                        <ImageView
                            android:id="@+id/iv_tab_checkin"
                            android:layout_width="@dimen/nav_icon_size"
                            android:layout_height="@dimen/nav_icon_size"
                            android:layout_gravity="center"
                            android:contentDescription="打卡"
                            android:src="@drawable/ic_checkin_line"
                            app:tint="@color/nav_icon_tint" />
                    </FrameLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/tab_mine"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/ripple_circle"
                    android:tooltipText="我的">

                    <FrameLayout
                        android:layout_width="@dimen/nav_touch_size"
                        android:layout_height="@dimen/nav_touch_size"
                        android:layout_gravity="center">

                        <ImageView
                            android:id="@+id/iv_tab_mine"
                            android:layout_width="@dimen/nav_icon_size"
                            android:layout_height="@dimen/nav_icon_size"
                            android:layout_gravity="center"
                            android:contentDescription="我的"
                            android:src="@drawable/ic_person_line"
                            app:tint="@color/nav_icon_tint" />
                    </FrameLayout>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
