<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面：Fragment 容器 + 自定义底部三 Tab 导航（v4.16：选中项加胶囊底 + 加大图标） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 自定义底部导航：白底 + 细分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/outline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/surface"
        android:orientation="horizontal"
        android:paddingVertical="2dp">

        <LinearLayout
            android:id="@+id/tab_shelf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <LinearLayout
                android:id="@+id/tab_shelf_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nav_selected"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="3dp">

                <ImageView
                    android:id="@+id/iv_tab_shelf"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="书架"
                    android:src="@drawable/ic_book" />

                <TextView
                    android:id="@+id/tv_tab_shelf"
                    style="@style/BottomNavText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="书架" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <LinearLayout
                android:id="@+id/tab_stats_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nav_selected"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="3dp">

                <ImageView
                    android:id="@+id/iv_tab_stats"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="统计"
                    android:src="@drawable/ic_chart" />

                <TextView
                    android:id="@+id/tv_tab_stats"
                    style="@style/BottomNavText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="统计" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_mine"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <LinearLayout
                android:id="@+id/tab_mine_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nav_selected"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="3dp">

                <ImageView
                    android:id="@+id/iv_tab_mine"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="我的"
                    android:src="@drawable/ic_person" />

                <TextView
                    android:id="@+id/tv_tab_mine"
                    style="@style/BottomNavText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="我的" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
