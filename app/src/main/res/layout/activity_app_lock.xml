<?xml version="1.0" encoding="utf-8"?>
<!-- 应用锁（v5.7 重做）：字标 + 纸色底，跟书架页头同一套品牌语言；
     外层 ScrollView 是为了在系统字体放大到 2.0 时文案不被裁掉 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_padding"
        android:paddingVertical="@dimen/space_xl">

        <ImageView
            android:layout_width="168dp"
            android:layout_height="48dp"
            android:adjustViewBounds="true"
            android:contentDescription="小书房"
            android:scaleType="fitCenter"
            android:src="@drawable/wordmark_white"
            app:tint="?attr/on_surface" />

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="@dimen/space_xl"
            android:background="@drawable/bg_lock_badge">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="已锁定"
                android:src="@drawable/ic_lock_line"
                app:tint="?attr/colorPrimary" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="书架已合上"
            android:textColor="?attr/on_surface"
            android:textSize="@dimen/text_title" />

        <TextView
            android:id="@+id/tv_lock_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:text="验证身份后继续整理你的书架"
            android:textColor="?attr/on_surface_variant"
            android:textSize="@dimen/text_body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_unlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:minWidth="200dp"
            android:text="解锁" />

        <TextView
            android:id="@+id/tv_lock_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="使用指纹 / 面容或手机锁屏密码"
            android:textColor="?attr/on_surface_variant"
            android:textSize="@dimen/text_body_small" />

        <TextView
            android:id="@+id/btn_disable_lock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingVertical="@dimen/space_sm"
            android:text="无法验证？关闭应用锁"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/text_body_small"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
