<?xml version="1.0" encoding="utf-8"?>
<!-- v4.21：底部半屏面板的一行明细（参照微信读书「全部记录」）
     布局：日期(左) + 权重条(中) + 数值(右) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <!-- 日期（如 10月15日）与星期分成两列，避免挤在一格被截断 -->
    <TextView
        android:id="@+id/tv_row_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:minWidth="58dp"
        android:textColor="@color/text_main"
        android:textSize="@dimen/text_body_small" />

    <TextView
        android:id="@+id/tv_row_sub"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_sub"
        android:textSize="@dimen/text_caption" />

    <!-- 权重条槽 -->
    <LinearLayout
        android:id="@+id/ll_row_bar_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginEnd="@dimen/space_sm"
        android:layout_weight="1"
        android:orientation="horizontal">

        <View
            android:id="@+id/v_row_bar"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_stat_bar" />

        <View
            android:id="@+id/v_row_bar_bg"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_row_track" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_row_value"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/text_main"
        android:textSize="@dimen/text_body_small" />
</LinearLayout>
