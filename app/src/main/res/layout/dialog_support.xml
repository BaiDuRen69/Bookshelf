<?xml version="1.0" encoding="utf-8"?>
<!-- 支持作者弹窗：支付宝 / 微信 两个入口（v2.5 打赏功能）
     v4.18：入口行改为描边卡片样式（bg_dialog_row），去掉 emoji 标题，
     视觉与「我的」页功能入口行保持一致。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/DialogContent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="感谢你的支持！选择一种方式，打赏给作者买杯咖啡吧。"
        android:textColor="?attr/on_surface_variant"
        android:textSize="@dimen/text_body_small"
        android:lineSpacingMultiplier="1.35" />

    <!-- 支付宝 -->
    <LinearLayout
        android:id="@+id/row_alipay"
        style="@style/DialogActionRow">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_blue"
            android:contentDescription="支付宝收款码"
            android:padding="9dp"
            android:src="@drawable/ic_qr"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="支付宝"
                android:textColor="?attr/on_surface"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="推荐使用支付宝扫码"
                android:textColor="?attr/on_surface_variant"
                android:textSize="@dimen/text_body_small" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="进入"
            android:src="@drawable/ic_arrow_right"
            app:tint="?attr/on_surface_variant" />
    </LinearLayout>

    <!-- 微信 -->
    <LinearLayout
        android:id="@+id/row_wechat"
        style="@style/DialogActionRow">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_green"
            android:contentDescription="微信收款码"
            android:padding="9dp"
            android:src="@drawable/ic_qr"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="微信"
                android:textColor="?attr/on_surface"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="推荐使用微信支付"
                android:textColor="?attr/on_surface_variant"
                android:textSize="@dimen/text_body_small" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="进入"
            android:src="@drawable/ic_arrow_right"
            app:tint="?attr/on_surface_variant" />
    </LinearLayout>
</LinearLayout>
