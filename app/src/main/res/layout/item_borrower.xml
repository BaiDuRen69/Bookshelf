<?xml version="1.0" encoding="utf-8"?>
<!-- 借阅人档案的一行：头像首字 + 名字 + 累计情况 + 在外本数 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/tv_initial"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_icon_container"
        android:gravity="center"
        android:text="张"
        android:textColor="?attr/colorPrimary"
        android:textSize="@dimen/text_body" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="张三"
            android:textColor="?attr/on_surface"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/tv_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="借过 3 本 · 逾期 1 次"
            android:textColor="?attr/on_surface_variant"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_out"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:text="在外 2"
        android:textColor="?attr/colorPrimary"
        android:textSize="@dimen/text_body_small" />
</LinearLayout>
