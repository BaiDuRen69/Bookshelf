<?xml version="1.0" encoding="utf-8"?>
<!-- 想读清单（v4.48）：买之前先记下来，买到了「转为藏书」 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Bookshelf.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_h"
        app:navigationIcon="@drawable/ic_back"
        app:title="想读清单" />

    <!-- v5.9.8 T3：排序入口与搜索开关同一行，互不挤压 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_wish_sort"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/page_padding"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp"
            android:text="排序：优先级 ▾"
            android:textColor="?attr/on_surface_variant"
            android:textSize="@dimen/text_body_small" />

        <TextView
            android:id="@+id/btn_wish_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/page_padding"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:text="搜索"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/text_body_small" />
    </LinearLayout>

    <!-- v5.9.8 T3：可折叠搜索行；收起时不占任何空间，列表高度不变 -->
    <LinearLayout
        android:id="@+id/ll_wish_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/page_padding"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_wish_search"
            style="@style/Widget.Bookshelf.TextField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="书名 / 作者 / ISBN / 备注">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_wish_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/btn_wish_search_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="清空"
            android:textColor="?attr/on_surface_variant"
            android:textSize="@dimen/text_body_small" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_wish"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/page_padding"
            android:scrollbarDefaultDelayBeforeFade="400"
            android:scrollbarFadeDuration="600"
            android:scrollbarThumbVertical="@drawable/wish_scrollbar_thumb"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/ll_wish_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- v5.7 收口：空态统一用共享组件，文案在代码里给 -->
            <include
                android:id="@+id/emptyState"
                layout="@layout/view_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- v5.9.8 T8 / v5.11 T2：悬浮「到顶 / 到底」改 56dp 正圆图标钮，锚在底部栏上方、随滚动显隐 -->
        <LinearLayout
            android:id="@+id/ll_wish_scroll_jump"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/page_padding"
            android:layout_marginBottom="12dp"
            android:alpha="0.92"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_wish_scroll_top"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="到顶"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="56dp"
                android:minHeight="56dp"
                app:icon="@drawable/ic_arrow_up"
                app:iconSize="22dp"
                app:iconTint="?attr/on_primary_container"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Bookshelf.Circle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_wish_scroll_bottom"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:contentDescription="到底"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="56dp"
                android:minHeight="56dp"
                app:icon="@drawable/ic_arrow_down"
                app:iconSize="22dp"
                app:iconTint="?attr/on_primary_container"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Bookshelf.Circle" />
        </LinearLayout>
    </FrameLayout>

    <!-- 多选操作条（v5.8.15）：与书架同一套浮起卡片，上行「已选 · 全选 · 退出」 -->
    <LinearLayout
        android:id="@+id/selection_bar_wish"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_lg"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_float_card"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_md"
        android:paddingTop="2dp"
        android:paddingEnd="@dimen/space_xs"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_wish_sel_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:text="已选 0 条"
                android:textColor="?attr/on_surface"
                android:textSize="@dimen/text_body_small"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_wish_sel_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"
                android:text="全选"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/text_body_small" />

            <TextView
                android:id="@+id/btn_wish_sel_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"
                android:text="退出"
                android:textColor="?attr/on_surface_variant"
                android:textSize="@dimen/text_body_small" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:background="?attr/outline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_wish_sel_edit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"
                android:text="批量编辑"
                android:textColor="?attr/on_surface"
                android:textSize="@dimen/text_body_small" />

            <TextView
                android:id="@+id/btn_wish_sel_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"
                android:text="删除"
                android:textColor="@color/danger"
                android:textSize="@dimen/text_body_small" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_wish_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/page_padding"
        android:paddingVertical="@dimen/space_sm">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_wish"
            style="@style/Widget.Bookshelf.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="＋ 添加想读" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_wish_continue"
            style="@style/Widget.Bookshelf.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="连续添加" />
    </LinearLayout>
</LinearLayout>
