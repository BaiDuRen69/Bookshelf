<?xml version="1.0" encoding="utf-8"?>
<!-- 打卡页：Toolbar / 悬浮「今」常驻，view_switch_host 内月视图与年视图互切。
     动画只作用于 host 内的两个 content：系统状态栏、MainActivity 的 dock 都不在动画树里。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.Bookshelf.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_h"
            android:clickable="true"
            android:contentDescription="打开年视图"
            android:foreground="?attr/selectableItemBackground"
            app:title="11月">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_year"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:contentDescription="打开年视图"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.04"
                    android:paddingHorizontal="@dimen/space_md"
                    android:text="年"
                    android:textColor="?attr/header_fg"
                    android:textSize="@dimen/text_body_small" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- 视图切换的唯一动画容器：月/年两层重叠，切换只动这一块 -->
        <FrameLayout
            android:id="@+id/view_switch_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/month_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <com.bai.bookshelf.ui.checkin.MonthGridView
                    android:id="@+id/month_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_padding"
                    android:layout_marginTop="@dimen/space_sm"
                    android:paddingHorizontal="@dimen/space_sm" />

                <LinearLayout
                    android:id="@+id/ll_checkin_legend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_padding"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/tv_legend_note"
                    style="@style/Text.Bookshelf.Overline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_padding"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:visibility="gone"
                    tools:text="点 = 实际读过的日子" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/page_padding"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="?attr/outline" />

                <LinearLayout
                    android:id="@+id/ll_checkin_summary"
                    style="@style/StatsSummaryRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_padding" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_checkin"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingBottom="@dimen/dock_reserve" />

                    <include
                        android:id="@+id/empty_state"
                        layout="@layout/view_empty_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- 年视图面板：同页内切换，不再启动独立 Activity；初始隐藏 -->
            <include
                android:id="@+id/year_content"
                layout="@layout/view_checkin_year_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/fab_today"
        android:layout_width="@dimen/fab_size"
        android:layout_height="@dimen/fab_size"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/space_xl"
        android:layout_marginBottom="@dimen/dock_reserve"
        android:contentDescription="回到今天"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:insetTop="0dp"
        android:padding="0dp"
        android:text="今"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="@dimen/text_body_large"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="@dimen/fab_corner"
        app:elevation="4dp" />
</FrameLayout>
