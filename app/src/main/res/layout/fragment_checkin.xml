<?xml version="1.0" encoding="utf-8"?>
<!-- 打卡页：Toolbar / 悬浮「今」常驻，view_switch_host 内月视图与年视图互切。
     动画只作用于 host 内的两个 content：系统状态栏、MainActivity 的 dock 都不在动画树里。
     根容器负责纵向收周/展开：整页可滑，列表滚动与横向切月各自保留。 -->
<com.bai.bookshelf.ui.checkin.CheckInSwipeRoot xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 4.4：年份/相对时间都收进自定义标题行；Toolbar 整块仍是年视图入口 -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.Bookshelf.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_h"
            android:clickable="true"
            android:contentDescription="打开年视图"
            android:foreground="?attr/selectableItemBackground"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp">

            <LinearLayout
                android:id="@+id/header_title_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="@dimen/space_lg"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_month_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:includeFontPadding="false"
                    android:textColor="?attr/header_fg"
                    android:textSize="@dimen/text_headline"
                    tools:text="11月" />

                <TextView
                    android:id="@+id/tv_month_relative"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="@dimen/space_xs"
                    android:alpha="0.7"
                    android:includeFontPadding="false"
                    android:textColor="?attr/header_fg"
                    android:textSize="@dimen/text_caption"
                    android:visibility="gone"
                    tools:text="488天前"
                    tools:visibility="visible" />

                <ImageView
                    android:id="@+id/iv_year_chevron"
                    android:layout_width="@dimen/checkin_year_chevron"
                    android:layout_height="@dimen/checkin_year_chevron"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="@dimen/space_xs"
                    android:alpha="0.7"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_down_line"
                    app:tint="?attr/header_fg" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- 视图切换的唯一动画容器：月/年两层重叠，切换只动这一块 -->
        <FrameLayout
            android:id="@+id/view_switch_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/month_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <com.bai.bookshelf.ui.checkin.MonthGridView
                    android:id="@+id/month_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_padding"
                    android:layout_marginTop="@dimen/space_sm"
                    android:paddingHorizontal="@dimen/space_sm" />

                <LinearLayout
                    android:id="@+id/ll_checkin_legend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_padding"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/tv_legend_note"
                    style="@style/Text.Bookshelf.Overline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_padding"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:visibility="gone"
                    tools:text="点 = 实际读过的日子" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/page_padding"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="?attr/outline" />

                <LinearLayout
                    android:id="@+id/ll_checkin_summary"
                    style="@style/StatsSummaryRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_padding" />

                <!-- 选中日动作条：一句说明 + 回到今天 + 全部打卡/补卡；撤销只在 5 秒内出现。
                     按钮用文本样式但压到 36dp 高，整行固定 40dp，不挤占列表。 -->
                <LinearLayout
                    android:id="@+id/ll_day_actions"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="@dimen/page_padding"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/fl_day_action"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <TextView
                            android:id="@+id/tv_day_action"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center_vertical"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="?attr/on_surface_variant"
                            android:textSize="@dimen/text_body_small"
                            tools:text="今天 · 还有 3 本未打卡" />

                        <TextView
                            android:id="@+id/tv_day_action_alt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center_vertical"
                            android:alpha="0"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="?attr/on_surface_variant"
                            android:textSize="@dimen/text_body_small" />
                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_day_undo"
                        style="@style/Widget.Bookshelf.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="@dimen/space_sm"
                        android:text="撤销"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_back_today"
                        style="@style/Widget.Bookshelf.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="@dimen/space_sm"
                        android:text="回到今天"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_batch_checkin"
                        style="@style/Widget.Bookshelf.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"
                        android:maxLines="1"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="@dimen/space_sm"
                        android:text="全部打卡" />
                </LinearLayout>

                <!-- 5.5：逐日明细的把手；手势之外给 TalkBack / 不知道手势的用户一个入口 -->
                <LinearLayout
                    android:id="@+id/ll_month_days_handle"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginHorizontal="@dimen/page_padding"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:contentDescription="查看本月逐日明细"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_month_days_label"
                        style="@style/Text.Bookshelf.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本月逐日" />

                    <ImageView
                        android:id="@+id/iv_month_days_arrow"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="@dimen/space_xs"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_down_line"
                        app:tint="?attr/on_surface_variant" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_checkin"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingBottom="@dimen/dock_reserve" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_month_days"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingBottom="@dimen/dock_reserve"
                        android:visibility="gone" />

                    <include
                        android:id="@+id/empty_state"
                        layout="@layout/view_empty_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- 年视图面板：同页内切换，不再启动独立 Activity；初始隐藏 -->
            <include
                android:id="@+id/year_content"
                layout="@layout/view_checkin_year_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/fab_today"
        android:layout_width="@dimen/fab_size"
        android:layout_height="@dimen/fab_size"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/space_xl"
        android:layout_marginBottom="@dimen/dock_reserve"
        android:contentDescription="回到今天"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:insetTop="0dp"
        android:padding="0dp"
        android:text="今"
        android:textColor="?attr/checkin_on_today"
        android:textSize="@dimen/text_body_large"
        app:backgroundTint="?attr/checkin_today_bg"
        app:cornerRadius="@dimen/fab_corner"
        app:elevation="4dp" />
</com.bai.bookshelf.ui.checkin.CheckInSwipeRoot>
