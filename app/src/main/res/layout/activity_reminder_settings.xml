<?xml version="1.0" encoding="utf-8"?>
<!-- 「通知与提醒」设置页（v5.8.33 重做）：每行右侧是真开关，副标题写「关掉之后会怎样」而不是状态，
     顶部一行摘要说清现在到底有几本书到期、通知有没有授权、闹钟还排不排。
     开关沿用 MineRow 的行高与令牌间距，控件用 Material3 的 MaterialSwitch。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Bookshelf.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_h"
        app:navigationIcon="@drawable/ic_back"
        app:title="通知与提醒" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/page_padding"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/content_max_width">

                <!-- 状态摘要：一眼看清「现在到底是什么状态」 -->
                <androidx.cardview.widget.CardView
                    style="@style/Widget.Bookshelf.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_lg">

                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="现在的状态" />

                        <TextView
                            android:id="@+id/tv_reminder_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:lineSpacingMultiplier="1.35"
                            android:text="正在统计…"
                            android:textColor="?attr/on_surface_variant"
                            android:textSize="@dimen/text_body_small" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_notify_settings"
                            style="@style/Widget.Bookshelf.Button.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:text="去系统设置"
                            android:visibility="gone" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ===== 系统通知 ===== -->
                <androidx.cardview.widget.CardView
                    style="@style/Widget.Bookshelf.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/space_sm">

                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="@dimen/space_lg"
                            android:paddingVertical="@dimen/space_sm"
                            android:text="系统通知" />

                        <LinearLayout
                            android:id="@+id/row_notify_borrow_due"
                            style="@style/MineRow">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/MineRowTitle"
                                    android:text="借阅到期通知" />

                                <TextView
                                    style="@style/MineRowSubtitle"
                                    android:text="关掉后不再发通知，当前通知立即撤下、每日闹钟取消" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_notify_borrow_due"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no" />
                        </LinearLayout>

                        <View style="@style/MineRowDivider" />

                        <!-- 第 4.4 步：每日打卡提醒（默认关，需系统通知权限） -->
                        <LinearLayout
                            android:id="@+id/row_notify_checkin_daily"
                            style="@style/MineRow">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/MineRowTitle"
                                    android:text="每日打卡提醒" />

                                <TextView
                                    style="@style/MineRowSubtitle"
                                    android:text="每天 21:00 提醒当天还没打卡；关掉后通知立即撤下、闹钟取消。没有系统通知权限时需先去系统设置开启" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_notify_checkin_daily"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no" />
                        </LinearLayout>

                        <View style="@style/MineRowDivider" />

                        <LinearLayout
                            android:id="@+id/row_notify_borrowed_in"
                            style="@style/MineRow">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/MineRowTitle"
                                    android:text="借入的书也提醒" />

                                <TextView
                                    style="@style/MineRowSubtitle"
                                    android:text="关掉后通知里不再出现「我从别人那借的书」到期" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_notify_borrowed_in"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ===== 应用内提示 ===== -->
                <androidx.cardview.widget.CardView
                    style="@style/Widget.Bookshelf.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/space_sm">

                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="@dimen/space_lg"
                            android:paddingVertical="@dimen/space_sm"
                            android:text="应用内提示" />

                        <LinearLayout
                            android:id="@+id/row_badge_overdue"
                            style="@style/MineRow">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/MineRowTitle"
                                    android:text="逾期角标" />

                                <TextView
                                    style="@style/MineRowSubtitle"
                                    android:text="关掉后统计图标上不再显示逾期数字" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_badge_overdue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no" />
                        </LinearLayout>

                        <View style="@style/MineRowDivider" />

                        <LinearLayout
                            android:id="@+id/row_banner_backup_stale"
                            style="@style/MineRow">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/MineRowTitle"
                                    android:text="备份超期提示条" />

                                <TextView
                                    style="@style/MineRowSubtitle"
                                    android:text="关掉后「我的」页不再出现备份超期提示" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_banner_backup_stale"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no" />
                        </LinearLayout>

                        <View style="@style/MineRowDivider" />

                        <LinearLayout
                            android:id="@+id/row_banner_borrow_due"
                            style="@style/MineRow">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/MineRowTitle"
                                    android:text="详情页到期条" />

                                <TextView
                                    style="@style/MineRowSubtitle"
                                    android:text="关掉后书籍详情页不再显示到期/逾期横条（不影响数据与借阅记录）" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_banner_borrow_due"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ===== 桌面与更新 ===== -->
                <androidx.cardview.widget.CardView
                    style="@style/Widget.Bookshelf.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/space_sm">

                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="@dimen/space_lg"
                            android:paddingVertical="@dimen/space_sm"
                            android:text="桌面与更新" />

                        <LinearLayout
                            android:id="@+id/row_widget_enabled"
                            style="@style/MineRow">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/MineRowTitle"
                                    android:text="桌面小组件刷新" />

                                <TextView
                                    style="@style/MineRowSubtitle"
                                    android:text="关掉后桌面组件内容不再随数据变化更新" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_widget_enabled"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no" />
                        </LinearLayout>

                        <View style="@style/MineRowDivider" />

                        <LinearLayout
                            android:id="@+id/row_prompt_new_version"
                            style="@style/MineRow">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_update_row_title"
                                    style="@style/MineRowTitle"
                                    android:text="发现新版本时提示我" />

                                <TextView
                                    android:id="@+id/tv_update_row_note"
                                    style="@style/MineRowSubtitle"
                                    android:text="关掉后启动发现新版本不再弹窗，可在「应用更新」手动检查" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_prompt_new_version"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:lineSpacingMultiplier="1.4"
                    android:text="关闭开关不会删除任何已记录的数据，只是不再提醒、不再显示角标。"
                    android:textColor="?attr/on_surface_variant"
                    android:textSize="@dimen/text_body_small" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</LinearLayout>
