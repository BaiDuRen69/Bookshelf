<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 书房主题色：墨绿 + 暖木色 + 米色纸感背景（默认主题） -->
    <color name="primary">#2E6E5C</color>
    <color name="primary_dark">#1F4D40</color>
    <color name="accent">#C08A3E</color>
    <color name="bg_page">#FAF7F2</color>
    <color name="text_main">#2B2B2B</color>
    <color name="text_sub">#8A8A8A</color>
    <color name="white">#FFFFFF</color>
    <color name="stat_bar">#7FB3A2</color>
    <color name="danger">#C0392B</color>
    <color name="selected_bg">#222E6E5C</color>

    <!-- ===== 语义色层（v4.16 视觉重构）：卡片面 / 描边 / 次级面 ===== -->
    <!-- 卡片面（与页面底色拉开一档） -->
    <color name="surface">#FFFFFF</color>
    <!-- 卡片内的次级面（输入框、占位图、进度条底） -->
    <color name="surface_dim">#F4F0E9</color>
    <!-- 常规描边：卡片、输入框、筛选器 -->
    <color name="outline">#E6E0D5</color>
    <!-- 强描边：聚焦态、强调元素 -->
    <color name="outline_strong">#CFC5B4</color>
    <!-- 封面占位底色（替代写死的 #EEE） -->
    <color name="cover_placeholder_bg">#E9E3D8</color>
    <!-- 底部导航条面（白底 + 上描边） -->
    <color name="nav_bar_bg">#FFFFFF</color>

    <!-- ===== 分割线 / 遮罩等半透明中性色（v3.0 收拢，避免各布局散落魔法值） ===== -->
    <!-- 极弱分割线：书脊下方阴影、卡片描边等 -->
    <color name="divider_faint">#12000000</color>
    <!-- 弱分割线：关于页/我的页分组之间 -->
    <color name="divider_soft">#14000000</color>
    <!-- 常规分割线：书架列表行分隔 -->
    <color name="divider_normal">#1A000000</color>
    <!-- 不透明浅灰分割线：详情页分隔线 -->
    <color name="divider_gray">#DDDDDD</color>
    <!-- 半透明黑色遮罩：扫描页取景框外区域 -->
    <color name="scrim_dark">#66000000</color>

    <!-- ===== 标签底色：随主题覆盖，保证换肤后协调（默认墨绿浅色） ===== -->
    <color name="chip_bg">#E8F0ED</color>
    <color name="blue_chip_bg">#E9EDF6</color>
    <color name="red_chip_bg">#F6EAE8</color>
    <color name="orange_chip_bg">#FAEEE2</color>
    <color name="purple_chip_bg">#EEEAF6</color>
    <color name="graphite_chip_bg">#E9EEEE</color>

    <!-- ===== 主题配色（v2.5 新增 5 套，与 themes.xml 的 Theme.Bookshelf.* 变体一一对应） ===== -->
    <!-- 黛蓝 -->
    <color name="blue_primary">#3A5BA0</color>
    <color name="blue_primary_dark">#2C4A7C</color>
    <color name="blue_accent">#C9A66B</color>
    <!-- 赭红 -->
    <color name="red_primary">#A34A3A</color>
    <color name="red_primary_dark">#7E3527</color>
    <color name="red_accent">#C9A66B</color>
    <!-- 暖橙 -->
    <color name="orange_primary">#C2701E</color>
    <color name="orange_primary_dark">#9C5614</color>
    <color name="orange_accent">#6E8B3D</color>
    <!-- 紫罗兰 -->
    <color name="purple_primary">#6B4E9E</color>
    <color name="purple_primary_dark">#523B7C</color>
    <color name="purple_accent">#C9A66B</color>
    <!-- 石墨 -->
    <color name="graphite_primary">#4A6B70</color>
    <color name="graphite_primary_dark">#375056</color>
    <color name="graphite_accent">#B08040</color>

    <!-- ===== 主题容器色（v4.16）：主色浅容器 + 容器上的文字色 =====
         与 chip_bg 一一对应，chip_bg 保留给历史代码，容器色用于新组件 -->
    <color name="green_container">#E6F0EC</color>
    <color name="green_on_container">#1C4A3E</color>
    <color name="blue_container">#E8EDF6</color>
    <color name="blue_on_container">#2A4676</color>
    <color name="red_container">#F6E9E7</color>
    <color name="red_on_container">#7A3226</color>
    <color name="orange_container">#FAEDDF</color>
    <color name="orange_on_container">#93510F</color>
    <color name="purple_container">#EDE9F6</color>
    <color name="purple_on_container">#4E3876</color>
    <color name="graphite_container">#E8EEEE</color>
    <color name="graphite_on_container">#334C51</color>
</resources>
