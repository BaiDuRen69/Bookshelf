<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== v4.16 视觉重构：统一组件样式 ===== -->

    <!-- 圆角：中等（按钮/输入框/标签） -->
    <style name="ShapeAppearance.Bookshelf.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/radius_md</item>
    </style>

    <!-- 主按钮：12dp 圆角 + 统一字号 -->
    <style name="Widget.Bookshelf.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.Bookshelf.Medium</item>
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">44dp</item>
        <item name="cornerRadius">@dimen/radius_md</item>
    </style>

    <!-- 描边按钮：与主按钮同形状，避免大小不一 -->
    <style name="Widget.Bookshelf.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.Bookshelf.Medium</item>
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">44dp</item>
        <item name="cornerRadius">@dimen/radius_md</item>
    </style>

    <!-- 文本按钮 -->
    <style name="Widget.Bookshelf.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="shapeAppearance">@style/ShapeAppearance.Bookshelf.Medium</item>
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="cornerRadius">@dimen/radius_md</item>
    </style>

    <!-- 弹窗按钮（v4.19）
         Material 的 m3_alert_dialog_actions.xml 用的是普通 <Button>，
         其 style 指向 ?attr/buttonBarPositiveButtonStyle。
         M3 默认给的是 Widget.Material3.Button.TextButton.Dialog（负责最小宽度与按钮间距），
         这里沿用它的 parent，只把字号统一到应用的小号正文，避免按钮大小忽大忽小。 -->
    <style name="Widget.Bookshelf.Button.Dialog" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- 色调按钮（次级强调） -->
    <style name="Widget.Bookshelf.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="shapeAppearance">@style/ShapeAppearance.Bookshelf.Medium</item>
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">44dp</item>
        <item name="cornerRadius">@dimen/radius_md</item>
    </style>

    <!-- 输入框：描边式 + 12dp 圆角（替代 M3 默认的 4dp 顶部小圆角） -->
    <style name="Widget.Bookshelf.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/text_field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxBackgroundColor">?attr/surface</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
        <item name="android:textColorHint">?attr/on_surface_variant</item>
    </style>

    <!-- 卡片：描边式（0 投影 + 1dp 描边），边界清晰且更轻盈现代 -->
    <style name="Widget.Bookshelf.Card" parent="CardView">
        <item name="cardCornerRadius">@dimen/card_corner</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/surface</item>
        <item name="strokeColor">?attr/outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- MaterialCardView 同款（统计/我的页用 Material 组件时保持一致） -->
    <style name="Widget.Bookshelf.MaterialCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_corner</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- 工具栏：主色底 + 白色标题 + 无阴影 -->
    <style name="Widget.Bookshelf.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="titleTextColor">?attr/colorOnPrimary</item>
        <item name="titleTextAppearance">@style/TextAppearance.Bookshelf.ToolbarTitle</item>
        <item name="navigationIconTint">?attr/colorOnPrimary</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="TextAppearance.Bookshelf.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- 两级标题：CardTitle（独立卡片 17sp 衬线）/ SectionTitle（卡内小标题 13sp sans-medium 次级色） -->
    <style name="CardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">?attr/on_surface</item>
    </style>

    <!-- ===== v4.24 字体体系：衬线只用于展示层（17sp 以上），正文与表单保持黑体 ===== -->
    <style name="Text.Bookshelf" parent="" />

    <style name="Text.Bookshelf.SerifTitle">
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Text.Bookshelf.SerifHeadline">
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- 数字：衬线 + 等宽数字，避免统计值跳动时左右抖动 -->
    <style name="Text.Bookshelf.SerifNumber">
        <item name="android:fontFamily">serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- 11–13sp 小标题统一走 sans-serif-medium（见 MineSectionTitle / DialogSectionTitle） -->

    <!-- ===== 详情页（v4.25） ===== -->
    <style name="DetailSectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/on_surface_variant</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- ===== 弹窗（v4.18）：统一内容区与标题的视觉规范 ===== -->

    <!-- Chip（全局统一，v4.18）：胶囊形 + 浅底 + 描边，选中态用主色容器 -->
    <style name="Widget.Bookshelf.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="shapeAppearance">@style/ShapeAppearance.Bookshelf.Pill</item>
        <item name="chipBackgroundColor">@color/chip_bg_state</item>
        <item name="chipStrokeColor">@color/chip_stroke_state</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text_state</item>
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipIconVisible">false</item>
        <item name="checkedIconVisible">false</item>
        <item name="closeIconVisible">false</item>
        <!-- 弹窗内 Chip 排得紧凑，关闭最小触摸区扩展，避免行高过大 -->
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="chipStartPadding">4dp</item>
        <item name="chipEndPadding">4dp</item>
        <item name="textStartPadding">10dp</item>
        <item name="textEndPadding">10dp</item>
    </style>

    <!-- Chip 胶囊形状 -->
    <style name="ShapeAppearance.Bookshelf.Pill" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Chip 描边状态色 -->
    <style name="Widget.Bookshelf.ChipGroup" parent="Widget.Material3.ChipGroup">
        <item name="chipSpacingHorizontal">8dp</item>
        <item name="chipSpacingVertical">4dp</item>
        <item name="singleLine">false</item>
    </style>

    <!-- 弹窗内容区：统一的左右留白与底部留白 -->
    <style name="DialogContent">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/space_xl</item>
        <item name="android:paddingEnd">@dimen/space_xl</item>
        <item name="android:paddingTop">@dimen/space_sm</item>
        <item name="android:paddingBottom">@dimen/space_xs</item>
    </style>

    <!-- 弹窗内的分组小标题 -->
    <style name="DialogSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/space_sm</item>
        <item name="android:textColor">?attr/on_surface_variant</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <!-- 弹窗内的说明文字 -->
    <style name="DialogHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_sm</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
        <item name="android:textColor">?attr/on_surface_variant</item>
        <item name="android:textSize">@dimen/text_body_small</item>
    </style>

    <!-- 弹窗内的可点击入口行（卡片式，比裸 LinearLayout 更有层次） -->
    <style name="DialogActionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_sm</item>
        <item name="android:background">@drawable/bg_dialog_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
        <item name="android:paddingTop">@dimen/space_md</item>
        <item name="android:paddingBottom">@dimen/space_md</item>
    </style>

    <!-- 弹窗入口行的图标底座（圆形，40dp） -->

    <!-- ===== 「我的」页功能入口行（v4.24：分区卡内的一行） ===== -->
    <style name="MineRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <!-- 行首 36dp 主色浅容器图标底座 -->
    <style name="MineRowIcon">
        <item name="android:layout_width">@dimen/mine_icon_box</item>
        <item name="android:layout_height">@dimen/mine_icon_box</item>
        <item name="android:background">@drawable/bg_icon_container</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">?attr/colorPrimary</item>
    </style>

    <!-- 行与行之间的内缩分割线（左起 56dp） -->
    <style name="MineRowDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">64dp</item>
        <item name="android:background">@color/divider_soft</item>
    </style>

    <!-- 行尾统一 16dp 细线箭头 -->
    <style name="MineRowChevron">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:layout_marginStart">@dimen/space_sm</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:src">@drawable/ic_chevron_right_line</item>
        <item name="android:tint">?attr/on_surface_variant</item>
    </style>

    <!-- 行内主标题 -->
    <style name="MineRowTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/on_surface</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- 行内副标题（功能说明 / 实时状态） -->
    <style name="MineRowSubtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">?attr/on_surface_variant</item>
        <item name="android:textSize">@dimen/text_body_small</item>
    </style>

    <!-- 分区标题：按功能分组，标题具体（Material Design 设置页规范） -->
    <style name="MineSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_xl</item>
        <item name="android:layout_marginBottom">@dimen/space_sm</item>
        <item name="android:paddingStart">@dimen/space_xs</item>
        <item name="android:textColor">?attr/on_surface_variant</item>
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- 底部导航小字号（配合低高度导航栏） -->
    <style name="BottomNavText">
        <item name="android:textSize">@dimen/tab_label_size</item>
    </style>

    <!-- 底部面板窗口动画（v4.27）：只做淡入淡出，不位移、不缩放 -->
    <style name="Animation.Bookshelf.Sheet" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/sheet_fade_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_fade_out</item>
    </style>
</resources>
