<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 全局主题：Material3 亮色，无默认 ActionBar（各页面自带 Toolbar）。
         Theme.Bookshelf 为默认「墨绿」；其余 5 套为 v2.5 主题选择变体，
         由 BaseActivity 在 super.onCreate 前按用户选择 setTheme 挂载。 -->
    <style name="Theme.Bookshelf" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:colorBackground">@color/bg_page</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <!-- 标签底色跟随主题，保证换肤一致 -->
        <item name="chip_bg">@color/chip_bg</item>
    </style>

    <style name="Theme.Bookshelf.Blue" parent="Theme.Material3.Light.NoActionBar">
