<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 全局主题：Material3 亮色，无默认 ActionBar（各页面自带 Toolbar）。
         Theme.Bookshelf 为默认「墨绿」；其余 5 套为 v2.5 主题选择变体，
         由 BaseActivity 在 super.onCreate 前按用户选择 setTheme 挂载。
         v4.16 视觉重构：公共属性收拢到 Theme.Bookshelf.Base，语义色层（surface/outline/
         容器色）随主题覆盖，组件形状（按钮/输入框/卡片）统一由组件样式接管。 -->
    <style name="Theme.Bookshelf.Base" parent="Theme.Material3.Light.NoActionBar">
        <!-- 页面底色 -->
        <item name="android:colorBackground">@color/bg_page</item>
        <!-- v5.8.28：主色兜底。下面 statusBarColor 吃 ?attr/colorPrimary，而本基线
             原先没定义 colorPrimary，父级 Theme.Material3.Light.NoActionBar 的基线主色
             是紫 #6750A4 —— 一旦有页面只挂到 Base（splash 的 postSplashScreenTheme 就是），
             状态栏立刻变紫。七套主题各自都覆盖这四个属性，所以补兜底不改变任何一套的观感。 -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <!-- v5.8.29：页头这一层单独成对。六套浅色主题页头 = 各自主色 + 白字，
             所以默认值就按墨绿写；夜读在自已那版里换成暗墨绿底 + 暗金字。 -->
        <!-- v5.9.1 L5 标签/单位字号档（夜读主题里覆盖成 12sp） -->
        <item name="text_size_overline">@dimen/text_caption</item>
        <item name="header_bg">@color/primary</item>
        <item name="header_fg">#FFFFFF</item>
        <!-- 状态栏与页头同色，视觉连成一体 -->
        <item name="android:statusBarColor">?attr/header_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- v4.25：书架 → 详情封面共享元素过渡 -->
        <item name="android:windowActivityTransitions">true</item>
        <!-- 语义色层（各主题只覆盖容器色，其余共用） -->
        <item name="surface">@color/surface</item>
        <item name="surface_dim">@color/surface_dim</item>
        <item name="outline">@color/outline</item>
        <item name="outline_strong">@color/outline_strong</item>
        <item name="on_surface">@color/text_main</item>
        <item name="on_surface_variant">@color/text_sub</item>
        <!-- v4.19：容器色给基线默认值，避免在弹窗主题（ThemeOverlay）下引用时取不到值 -->
        <item name="primary_container">@color/green_container</item>
        <item name="on_primary_container">@color/green_on_container</item>
        <!-- 打卡选中格：默认就等于各主题的容器色，只有夜读需要更亮一档 + 一圈描边 -->
        <item name="checkin_selected_bg">?attr/primary_container</item>
        <item name="checkin_selected_stroke">@android:color/transparent</item>
        <!-- v4.19：标签底色也给基线默认值（同上） -->
        <item name="chip_bg">@color/chip_bg</item>
        <!-- v4.24：黄铜文字色（colorSecondary 只用于填充，白字对比度不足） -->
        <item name="accent_text">@color/accent_text</item>
        <!-- v5.8.26：浮动 dock 的面色。六套浅色主题都继承本基线，只有夜读覆盖成
             dock_surface_night，所以这里给一次即等于「7 个主题各自指向」 -->
        <item name="dock_bg">@color/dock_surface</item>
        <!-- v4.19：把 Material3 的「表面色系」对齐到应用的暖白语义色。
             M3 默认 colorSurfaceContainerHigh 是淡紫色 #ECE6F0，弹窗底色会与
             应用整体的米白/白卡片风格打架，这里统一到 surface / surface_dim。 -->
        <item name="colorOnSurface">@color/text_main</item>
        <item name="colorOnSurfaceVariant">@color/text_sub</item>
        <item name="colorOnBackground">@color/text_main</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceBright">@color/surface</item>
        <item name="colorSurfaceDim">@color/surface_dim</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/surface_dim</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline</item>
        <!-- v4.19：关闭 M3 的 elevation overlay（elevated 表面会按主色染色）。
             本应用是「0 投影 + 1dp 描边」的扁平风格，开启后弹窗/FAB 等 elevated
             表面会被主色染成淡绿（实测弹窗底 #E8EFED 而不是纯白），与米白基调不符。 -->
        <item name="elevationOverlayEnabled">false</item>
        <!-- 组件统一形状 -->
        <item name="materialButtonStyle">@style/Widget.Bookshelf.Button</item>
        <item name="textInputStyle">@style/Widget.Bookshelf.TextField</item>
        <item name="materialCardViewStyle">@style/Widget.Bookshelf.MaterialCard</item>
        <!-- v4.18：Chip 全局统一（胶囊形 + 浅底 + 描边），弹窗与页面一致 -->
        <item name="chipStyle">@style/Widget.Bookshelf.Chip</item>
        <item name="chipGroupStyle">@style/Widget.Bookshelf.ChipGroup</item>
        <!-- v4.18：弹窗统一走 Material3 对话框外观（圆角、标题层级、按钮位置） -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Bookshelf.Dialog</item>
        <!-- v4.21：底部半屏面板（BottomSheet）统一走 M3 外观 + 应用自己的表面色/圆角 -->
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Bookshelf.BottomSheet</item>
    </style>

    <!-- v4.18：弹窗主题覆盖：标题更紧凑、正文次级色、按钮统一为文本按钮

         ⚠ v4.19 修复（重要）：materialAlertDialogTitleTextStyle / BodyTextStyle
         指向的样式<b>必须继承 Material 自己的弹窗样式</b>。
         原因：Material 的 m3_alert_dialog_title.xml 里，标题控件
         <DialogTitle style="?attr/materialAlertDialogTitleTextStyle"/> 并没有写
         android:layout_width / layout_height，这两项来自样式链末端
         Base.MaterialAlertDialog.MaterialComponents.Title.Text。
         如果把该属性指向一个「纯 TextAppearance」（只管字号字色），
         标题控件就拿不到布局尺寸，弹窗一打开即抛
         InflateException: You must supply a layout_width attribute，
         导致全应用所有弹窗一点就闪退。 -->
    <style name="ThemeOverlay.Bookshelf.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.Bookshelf.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Bookshelf.DialogBody</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Bookshelf.Button.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Bookshelf.Button.Dialog</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Bookshelf.Button.Dialog</item>
        <!-- 弹窗背景圆角：M3 默认 28dp 过大，v5.8.22 收到弹窗档 radius_2xl=24dp -->
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Bookshelf.Dialog</item>
    </style>

    <!-- 弹窗形状：24dp 圆角（v5.8.22 起弹窗/面板单独一档，比卡片 16dp 更圆） -->
    <style name="ShapeAppearance.Bookshelf.Dialog" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/radius_2xl</item>
    </style>

    <!-- v4.21：底部半屏面板主题（参照微信读书「全部记录」）
         只圆上方两角（底部贴屏幕边），表面色对齐应用语义色，不做主色染色。 -->
    <style name="ThemeOverlay.Bookshelf.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Bookshelf.BottomSheet</item>
    </style>

    <!-- 半屏面板本体样式 -->
    <style name="Widget.Bookshelf.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.Bookshelf.BottomSheet</item>
        <item name="backgroundTint">?attr/surface</item>
        <!-- v4.19：与全局一致关闭 elevation overlay，避免面板底色被主色染绿 -->
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <!-- 半屏面板形状：上方 24dp 圆角（与弹窗同档），下方直角 -->
    <style name="ShapeAppearance.Bookshelf.BottomSheet" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSizeTopLeft">@dimen/radius_2xl</item>
        <item name="cornerSizeTopRight">@dimen/radius_2xl</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- 弹窗标题：16sp 加粗（应用内标题层级，M3 默认 24sp 过大）
         v4.19：parent 改为 Material 的弹窗标题样式，保留其 layout_width/height、
         ellipsize、singleLine、layout_gravity 等布局属性（详见 ThemeOverlay.Bookshelf.Dialog 注释） -->
    <style name="TextAppearance.Bookshelf.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">@dimen/text_title_toolbar</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/on_surface</item>
    </style>

    <!-- 弹窗正文：13sp 次级色
         v4.19：同样继承 Material 的弹窗正文样式，保持 textAppearance 链完整 -->
    <style name="TextAppearance.Bookshelf.DialogBody" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:textColor">?attr/on_surface_variant</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <!-- 启动主题（v4.28）：只用于 MainActivity 的首帧；v31 里补系统 SplashScreen 属性 -->
    <!-- v5.8.7：冷启动用 compat SplashScreen，才能在退场时做字标淡出 + 内容淡入 -->
    <style name="Theme.Bookshelf.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_page</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_brand</item>
        <!-- v5.8.28：本 style 在 values-v31 里另有一版（parent 换成 Theme.Bookshelf.Base），
             所以 31+ 走的是那条链；31 以下才是这里的 Theme.SplashScreen
             （→ android:Theme.DeviceDefault，它的基线主色正是紫 #6750A4）。
             MainActivity 必须在 super.onCreate 之前 installSplashScreen()，那段时间
             窗口挂的就是本主题，任何 ?attr/colorPrimary 解析都会拿到紫，兜底要补一遍。 -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <!-- v5.8.28：必须指向具体的默认主题（墨绿），不能指 Base。
             core-splashscreen 退场时会把 Activity 主题重设成这个值，指 Base 等于
             把用户主题整个覆盖掉，状态栏色回落到基线紫 #6750A4。 -->
        <item name="postSplashScreenTheme">@style/Theme.Bookshelf</item>
    </style>

    <style name="Theme.Bookshelf.Night" parent="Theme.Bookshelf.Base">
        <!-- 主色直接用暗金：数字/链接在炭黑上足够亮；按钮/表头文字改深墨（colorOnPrimary） -->
        <item name="colorPrimary">@color/night_accent</item>
        <!-- v5.9.1：夜读下 L5 一律提到 12sp（炭黑上 11sp 太细） -->
        <item name="text_size_overline">@dimen/text_caption_night</item>
        <item name="colorPrimaryVariant">@color/night_primary_dark</item>
        <item name="colorSecondary">@color/night_accent</item>
        <item name="colorOnPrimary">@color/night_ink</item>
        <!-- v5.8.29：页头不再用亮金底。暗墨绿 #26302C 上放暗金 #D8B77E，
             实测对比 7.13:1（原来白字压亮金 #C9A66B 只有 2.13:1）。
             colorPrimary 仍是 night_accent：按钮/链接/大数字要那个亮度。 -->
        <item name="header_bg">@color/night_container</item>
        <item name="header_fg">@color/night_accent_text</item>
        <!-- v5.8.29 改注：夜读页头现在是暗墨绿 header_bg（#26302C），不再是炭黑页面色；
             状态栏取 header_bg 后仍是深底 → 浅色（白）图标，false 没变。
             运行时 BaseActivity 还会按 isLightColor() 再兜一次。 -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="chip_bg">@color/night_chip_bg</item>
        <item name="accent_text">@color/night_accent_text</item>
        <item name="primary_container">@color/night_container</item>
        <item name="on_primary_container">@color/night_on_container</item>
        <!-- v5.9.2 打卡选中格：规格给的 night_chip_bg(#2A2723) 压在 #1E1B18 卡面上只有
             1.15:1（比原 night_container 的 1.26:1 还低），outline_strong(#4C443B) 也只有
             1.79:1，两者都够不到 WCAG 1.4.11 的 3:1。底色照规格保留，可识别性交给描边：
             描边改用 on_surface_variant(#B5AEA3) = 7.79:1。 -->
        <item name="checkin_selected_bg">@color/night_chip_bg</item>
        <item name="checkin_selected_stroke">?attr/on_surface_variant</item>
        <item name="android:colorBackground">@color/night_page</item>
        <item name="surface">@color/night_surface</item>
        <!-- v5.8.26：夜读的 dock 要比炭黑卡面亮一档，否则去掉描边后与内容糊在一起 -->
        <item name="dock_bg">@color/dock_surface_night</item>
        <item name="surface_dim">@color/night_surface_dim</item>
        <item name="outline">@color/night_outline</item>
        <item name="outline_strong">@color/night_outline_strong</item>
        <item name="on_surface">@color/night_text_main</item>
        <item name="on_surface_variant">@color/night_text_sub</item>
        <item name="colorOnSurface">@color/night_text_main</item>
        <item name="colorOnSurfaceVariant">@color/night_text_sub</item>
        <item name="colorOnBackground">@color/night_text_main</item>
        <item name="colorSurface">@color/night_surface</item>
        <item name="colorSurfaceBright">@color/night_surface</item>
        <item name="colorSurfaceContainer">@color/night_surface</item>
        <item name="colorSurfaceContainerLow">@color/night_surface</item>
        <item name="colorSurfaceContainerLowest">@color/night_surface</item>
        <item name="colorSurfaceContainerHigh">@color/night_surface</item>
        <item name="colorSurfaceDim">@color/night_surface_dim</item>
        <item name="colorSurfaceContainerHighest">@color/night_surface_dim</item>
        <item name="colorOutline">@color/night_outline</item>
        <item name="colorOutlineVariant">@color/night_outline</item>
    </style>

