<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 全局主题：Material3 亮色，无默认 ActionBar（各页面自带 Toolbar）。
         Theme.Bookshelf 为默认「墨绿」；其余 5 套为 v2.5 主题选择变体，
         由 BaseActivity 在 super.onCreate 前按用户选择 setTheme 挂载。
         v4.16 视觉重构：公共属性收拢到 Theme.Bookshelf.Base，语义色层（surface/outline/
         容器色）随主题覆盖，组件形状（按钮/输入框/卡片）统一由组件样式接管。 -->
    <style name="Theme.Bookshelf.Base" parent="Theme.Material3.Light.NoActionBar">
        <!-- 页面底色 -->
        <item name="android:colorBackground">@color/bg_page</item>
        <!-- 状态栏与工具栏同色，视觉连成一体 -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- 语义色层（各主题只覆盖容器色，其余共用） -->
        <item name="surface">@color/surface</item>
        <item name="surface_dim">@color/surface_dim</item>
        <item name="outline">@color/outline</item>
        <item name="outline_strong">@color/outline_strong</item>
        <item name="on_surface">@color/text_main</item>
        <item name="on_surface_variant">@color/text_sub</item>
        <!-- 组件统一形状 -->
        <item name="materialButtonStyle">@style/Widget.Bookshelf.Button</item>
        <item name="textInputStyle">@style/Widget.Bookshelf.TextField</item>
        <item name="materialCardViewStyle">@style/Widget.Bookshelf.MaterialCard</item>
        <!-- v4.18：Chip 全局统一（胶囊形 + 浅底 + 描边），弹窗与页面一致 -->
        <item name="chipStyle">@style/Widget.Bookshelf.Chip</item>
        <item name="chipGroupStyle">@style/Widget.Bookshelf.ChipGroup</item>
        <!-- v4.18：弹窗统一走 Material3 对话框外观（圆角、标题层级、按钮位置） -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Bookshelf.Dialog</item>
    </style>

    <!-- v4.18：弹窗主题覆盖：标题更紧凑、正文次级色、按钮统一为文本按钮 -->
    <style name="ThemeOverlay.Bookshelf.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.Bookshelf.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Bookshelf.DialogBody</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Bookshelf.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Bookshelf.Button.Text</item>
        <!-- 弹窗背景圆角：M3 默认 28dp 过大，这里收紧到与应用卡片一致 -->
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Bookshelf.Dialog</item>
    </style>

    <!-- 弹窗形状：16dp 圆角（与应用卡片一致，M3 默认 28dp 过大） -->
    <style name="ShapeAppearance.Bookshelf.Dialog" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/card_corner</item>
    </style>

    <!-- 弹窗标题：16sp 加粗（应用内标题层级，M3 默认 24sp 过大） -->
    <style name="TextAppearance.Bookshelf.DialogTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title_toolbar</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/on_surface</item>
    </style>

    <!-- 弹窗正文：13sp 次级色 -->
    <style name="TextAppearance.Bookshelf.DialogBody" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:textColor">?attr/on_surface_variant</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="Theme.Bookshelf" parent="Theme.Bookshelf.Base">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <!-- 标签底色跟随主题，保证换肤一致 -->
        <item name="chip_bg">@color/chip_bg</item>
        <item name="primary_container">@color/green_container</item>
        <item name="on_primary_container">@color/green_on_container</item>
    </style>

    <style name="Theme.Bookshelf.Blue" parent="Theme.Bookshelf.Base">
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorPrimaryVariant">@color/blue_primary_dark</item>
        <item name="colorSecondary">@color/blue_accent</item>
        <item name="chip_bg">@color/blue_chip_bg</item>
        <item name="primary_container">@color/blue_container</item>
        <item name="on_primary_container">@color/blue_on_container</item>
    </style>

    <style name="Theme.Bookshelf.Red" parent="Theme.Bookshelf.Base">
        <item name="colorPrimary">@color/red_primary</item>
        <item name="colorPrimaryVariant">@color/red_primary_dark</item>
        <item name="colorSecondary">@color/red_accent</item>
        <item name="chip_bg">@color/red_chip_bg</item>
        <item name="primary_container">@color/red_container</item>
        <item name="on_primary_container">@color/red_on_container</item>
    </style>

    <style name="Theme.Bookshelf.Orange" parent="Theme.Bookshelf.Base">
        <item name="colorPrimary">@color/orange_primary</item>
        <item name="colorPrimaryVariant">@color/orange_primary_dark</item>
        <item name="colorSecondary">@color/orange_accent</item>
        <item name="chip_bg">@color/orange_chip_bg</item>
        <item name="primary_container">@color/orange_container</item>
        <item name="on_primary_container">@color/orange_on_container</item>
    </style>

    <style name="Theme.Bookshelf.Purple" parent="Theme.Bookshelf.Base">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryVariant">@color/purple_primary_dark</item>
        <item name="colorSecondary">@color/purple_accent</item>
        <item name="chip_bg">@color/purple_chip_bg</item>
        <item name="primary_container">@color/purple_container</item>
        <item name="on_primary_container">@color/purple_on_container</item>
    </style>

    <style name="Theme.Bookshelf.Graphite" parent="Theme.Bookshelf.Base">
        <item name="colorPrimary">@color/graphite_primary</item>
        <item name="colorPrimaryVariant">@color/graphite_primary_dark</item>
        <item name="colorSecondary">@color/graphite_accent</item>
        <item name="chip_bg">@color/graphite_chip_bg</item>
        <item name="primary_container">@color/graphite_container</item>
        <item name="on_primary_container">@color/graphite_on_container</item>
    </style>
</resources>
