<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 自定义主题属性（v3.0 新增 chip_bg）。
         用于让随主题变化的浅色底（标签背景）在各主题里能被独立覆盖；
         引用方式与 ?attr/colorPrimary 相同，主题未设置时会回退到 colors.xml 同名颜色。

         v4.16 视觉重构：补充 surface / outline 等语义色属性，
         布局统一用 ?attr/xxx 取值，六套主题各自覆盖，保证换肤后整体协调。 -->
    <!-- v5.9.1 六级字阶 L5 的字号档：浅色主题 11sp，夜读主题 12sp -->
    <attr name="text_size_overline" format="dimension|reference" />
    <attr name="chip_bg" format="color" />
    <attr name="surface" format="color" />
    <attr name="surface_dim" format="color" />
    <attr name="outline" format="color" />
    <attr name="outline_strong" format="color" />
    <attr name="on_surface" format="color" />
    <attr name="on_surface_variant" format="color" />
    <attr name="primary_container" format="color" />
    <attr name="on_primary_container" format="color" />
    <!-- 打卡页选中格：浅色主题跟 primary_container，夜读另给一档更亮的底 + 一圈描边，
         否则 #26302C 压在 #1E1B18 卡面上几乎看不出被选中 -->
    <attr name="checkin_selected_bg" format="color" />
    <attr name="checkin_selected_stroke" format="color" />
    <!-- v4.24：黄铜作文字时的深色版本（填充仍用 colorSecondary） -->
    <attr name="accent_text" format="color" />
    <!-- v5.8.26：浮动 dock 的面色（比 surface 亮一档，六套浅色主题共用，夜读单独覆盖） -->
    <attr name="dock_bg" format="color" />
    <!-- v5.8.29：页头这一层单独成对，不再借用 colorPrimary/colorOnPrimary。
         夜读的 colorPrimary 必须是暗金（按钮/链接/大数字要它亮），可页头底色不能是暗金
         （白字压暗金只有 2.13:1），所以底色与前景色要能各自独立指定。 -->
    <attr name="header_bg" format="color" />
    <attr name="header_fg" format="color" />
    <!-- 打卡日历「非今天选中」的正圆描边框色；基线取 outline_strong，各主题自动跟随 -->
    <attr name="checkin_day_ring" format="color" />
    <!-- 打卡月历的邻月日号：单独一档灰，和本月 on_surface 拉开可辨识的层级 -->
    <attr name="checkin_adjacent_text" format="color" />
    <!-- 今天不再吃 colorPrimary：暖色底 + 反色字 + 选中外圈各自独立，
         否则七套主题里今天和 Toolbar / 主按钮是同一个绿/蓝/红 -->
    <attr name="checkin_today_bg" format="color" />
    <attr name="checkin_on_today" format="color" />
    <attr name="checkin_today_ring" format="color" />
    <!-- 法定节假日：暖色文字，跟主题走 accent_text；只用于文字，不用于填充 -->
    <attr name="checkin_holiday_text" format="color" />
</resources>
