<?xml version="1.0" encoding="utf-8"?>
<!-- 设计令牌（v4.16 视觉重构）：间距 / 圆角 / 字号 / 页面尺寸
     全部布局统一引用这里，避免各页面散落魔法值。
     大屏（平板、折叠屏展开态）覆盖见 values-sw600dp 与 values-sw840dp。 -->
<resources>
    <!-- ===== 间距：4 / 8 栅格 ===== -->
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_sm">8dp</dimen>
    <dimen name="space_md">12dp</dimen>
    <dimen name="space_lg">16dp</dimen>
    <dimen name="space_xl">20dp</dimen>

    <!-- ===== 圆角 ===== -->
    <!-- 6dp：只给 40dp 宽的小封面用。书架/统计/编辑页的封面仍是 radius_sm(8dp)，
         那个尺寸下 8dp 才像书脊；小格子用 8dp 会圆成方块。 -->
    <dimen name="radius_xs">6dp</dimen>
    <dimen name="radius_sm">8dp</dimen>
    <dimen name="radius_md">12dp</dimen>
    <dimen name="radius_lg">16dp</dimen>
    <dimen name="radius_xl">20dp</dimen>
    <dimen name="radius_2xl">24dp</dimen>
    <!-- 胶囊值 = 控件高度的一半；控件高度变了要同步改，不要写 50%（shape XML 不支持） -->
    <dimen name="radius_pill">22dp</dimen>

    <!-- ===== 底部导航浮动 dock（v5.8.25 起，v5.8.26 真浮动）===== -->
    <dimen name="dock_h">68dp</dimen>
    <dimen name="dock_radius">34dp</dimen>
    <dimen name="dock_padding_h">8dp</dimen>
    <dimen name="dock_margin_bottom">12dp</dimen>
    <dimen name="dock_elevation">14dp</dimen>
    <dimen name="nav_indicator_size">56dp</dimen>
    <dimen name="nav_icon_size">26dp</dimen>
    <dimen name="nav_touch_size">56dp</dimen>
    <!-- 内容避让：dock_h 68 + dock_margin_bottom 12 + 8dp 呼吸 -->
    <dimen name="dock_reserve">88dp</dimen>
    <!-- dock 下方那层渐隐遮罩的高度，让内容滚到 dock 底下时不生硬 -->
    <dimen name="dock_scrim_h">120dp</dimen>

    <!-- ===== 打卡页专用（feature/clock-in）=====
         月视图格子、打卡点、切月位移、悬浮按钮：整页尺寸只改这里，不散着改代码。 -->
    <dimen name="checkin_cell_h">48dp</dimen>       <!-- 原 44dp，抬到 48dp 呼吸与触控更稳 -->
    <dimen name="checkin_week_w">28dp</dimen>
    <dimen name="checkin_dot_size">4dp</dimen>
    <dimen name="checkin_dot_size_multi">3dp</dimen>
    <dimen name="checkin_dot_gap">3dp</dimen>
    <dimen name="checkin_dot_bottom">6dp</dimen>
    <!-- 名字沿用规格，实际用途是描边圆的半径内缩（半径 = 半边长 - 这个值），不是线宽 -->
    <dimen name="checkin_ring_stroke">1.5dp</dimen>
    <!-- 夜读选中胶囊外那一圈描边的线宽（浅色主题这圈是透明的） -->
    <dimen name="checkin_selected_stroke_w">1dp</dimen>
    <dimen name="checkin_swipe_distance">24dp</dimen>
    <dimen name="fab_size">56dp</dimen>
    <dimen name="fab_corner">28dp</dimen>            <!-- = fab_size 的一半，胶囊公式 -->
    <!-- 列表行封面：40×53 ≈ 3:4，比书架的 40×56 略扁，行高更紧 -->
    <dimen name="checkin_cover_w">40dp</dimen>
    <dimen name="checkin_cover_h">53dp</dimen>
    <dimen name="checkin_button_icon">18dp</dimen>
    <!-- 「已打卡」描边按钮的线宽，和卡片描边同为 1dp -->
    <dimen name="checkin_button_stroke">1dp</dimen>

    <!-- ===== 字阶（v4.24 收敛为 28 / 22 / 17 / 15 / 13 / 11 六档；v4.25 统计 hero 40） ===== -->
    <dimen name="text_micro">9sp</dimen>
    <dimen name="text_caption_large">12sp</dimen>
    <dimen name="text_body_medium">14sp</dimen>
    <dimen name="text_body_large">16sp</dimen>
    <dimen name="text_title_small">20sp</dimen>
    <dimen name="text_display_large">32sp</dimen>
    <!-- v5.8.6：主数字版式（Metric）四档 -->
    <dimen name="text_metric_hero">40sp</dimen>
    <dimen name="text_metric_value">28sp</dimen>
    <dimen name="text_display">28sp</dimen>
    <dimen name="text_title">22sp</dimen>
    <dimen name="text_headline">17sp</dimen>
    <dimen name="text_body">15sp</dimen>
    <dimen name="text_body_small">13sp</dimen>
    <dimen name="text_caption">11sp</dimen>
    <!-- v5.9.1 六级字阶补档：L2 次级数字 / L3 行内数值 / L5 夜读档（样式层用 ?attr 选档） -->
    <dimen name="text_metric_small">20sp</dimen>
    <dimen name="text_row_value">15sp</dimen>
    <dimen name="text_caption_night">12sp</dimen>

    <!-- ===== 页面 ===== -->
    <dimen name="page_padding">16dp</dimen>
    <!-- 列表卡片可以比正文页更贴边，避免封面列被压得太窄 -->
    <dimen name="page_padding_list">12dp</dimen>
    <!-- 我的页：36dp 图标底座 -->
    <dimen name="mine_icon_box">36dp</dimen>
    <!-- 内容最大宽度：手机端不限制（9999dp），sw600dp 起收窄，避免大屏行长过长 -->
    <dimen name="content_max_width">9999dp</dimen>
    <dimen name="card_corner">16dp</dimen>
    <!-- 工具栏：紧凑高度（v4.17 压缩上下留白） -->
    <dimen name="toolbar_h">48dp</dimen>
    <dimen name="text_title_toolbar">16sp</dimen>
</resources>
