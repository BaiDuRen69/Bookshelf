<?xml version="1.0" encoding="utf-8"?>
<!-- 底部导航浮动 dock 的容器底：34dp = dock_h 68dp 的一半，真胶囊。
     面色走 ?attr/dock_bg（比 surface 亮一档）。v5.8.26 去掉描边——描边是「线框感」的
     根因，分层交给 14dp 阴影 + 0.95 alpha；真机若分不开，补的是极淡墨色描边而不是 outline 色。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="?attr/dock_bg" />
    <corners android:radius="@dimen/dock_radius" />
</shape>
