<?xml version="1.0" encoding="utf-8"?>
<!-- v4.22：分段控件（按月 / 按年）的选中块
     参照微信读书：选中项是一枚白色圆角胶囊，未选中是透明底。
     半径按同心公式取 13 = 外层 bg_seg_track 16 − 容器 padding 3（统计页 / 购买日历都是 3dp；
     阅读统计页那处容器 padding 是 4dp，严格同心应为 12，差 1dp 看不出来，没去改它的 padding）。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="?attr/surface" />
    <corners android:radius="13dp" />
    <stroke
        android:width="1dp"
        android:color="?attr/outline" />
</shape>
