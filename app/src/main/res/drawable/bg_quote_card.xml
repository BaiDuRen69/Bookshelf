<?xml version="1.0" encoding="utf-8"?>
<!-- 备注引用块（v4.25）：白面描边卡片 + 左侧 3dp 黄铜竖线 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/surface" />
            <stroke android:width="1dp" android:color="?attr/outline" />
            <corners android:radius="@dimen/card_corner" />
        </shape>
    </item>
    <item
        android:width="3dp"
        android:left="14dp"
        android:top="14dp"
        android:bottom="14dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSecondary" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
