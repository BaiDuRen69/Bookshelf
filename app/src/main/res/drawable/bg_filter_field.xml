<?xml version="1.0" encoding="utf-8"?>
<!-- 筛选下拉框背景（v4.16）：描边圆角 + 右侧下拉箭头，替代系统默认下划线样式 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/surface" />
            <stroke android:width="1dp" android:color="?attr/outline" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_chevron_down"
        android:gravity="end|center_vertical"
        android:right="8dp"
        android:width="16dp"
        android:height="16dp" />
</layer-list>
